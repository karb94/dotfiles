919]],["^15",[120,"^Q","[NixOS manual](https://nixos.org/manual/nixos/unstable/)",536870919]],["^15",[120,"^O","^16",536870919]],["^15",[120,"^F",115,536870919]],["^15",[120,"^X",29,536870919]],["^15",[120,"^V",115,536870919]],["^15",[120,"^U",29,536872273]],["^15",[120,"^;","~u661a3633-6011-464d-8a66-09fc1c5c29e1",536870919]],["^15",[121,"^Q","You can set up [[Impermanence]] in your system",536870919]],["^15",[121,"^O","^16",536870919]],["^15",[121,"^F",115,536870919]],["^15",[121,"^X",29,536870919]],["^15",[121,"^V",29,536870919]],["^15",[121,"^U",29,536870919]],["^15",[121,"^U",53,536870919]],["^15",[121,"^H",53,536884349]],["^15",[121,"^;","~u661a3633-1f05-4c49-9f51-0d3e4b41390b",536870919]],["^15",[122,"^Q","[Nixpkgs manual](https://nixos.org/manual/nixpkgs/unstable/)",536870919]],["^15",[122,"^O","^16",536870919]],["^15",[122,"^F",110,536870919]],["^15",[122,"^X",29,536870919]],["^15",[122,"^V",115,536870919]],["^15",[122,"^U",29,536872273]],["^15",[122,"^;","~u661a3633-56aa-4d84-ad1e-0e8a61d5c495",536870919]],["^15",[123,"^3","- spelling rules\n\t- -ы ⇒ -и\n\t  id:: 66e8aeee-3856-4b1f-91e6-800931d44354\n\t\t- after\n\t\t\t- г/к/х: back of the mouth pronunciation\n\t\t\t- ж/ш: 2 of the 3 consonants that are always hard\n\t\t\t- ч/щ: the two consonants that a are always soft\n\t- о ⇒ е\n\t\t- after ж/ч/ш/щ/ц\n\t\t\t- adjectives:\n\t\t\t\t- -ое ⇒ -ее\n\t\t\t\t\t- хор**о**ш-ее р**у**сск-ое вин**о** (good russian wine)\n\t\t\t\t\t- св**е**ж-ее яйц**о** (fresh egg)\n\t\t\t\t- -ем ⇒ -ом\n\t\t\t\t\t- в хор**о**ш-ем р**у**сск-ом рестор**а**не (in a good russian restaurant)\n\t\t\t\t- -ей ⇒ -ой\n\t\t\t\t\t- в гор**я**ч-ей вод**е** (in hot water)\n\t\t\t\t- наш ⇒ наше\n\t\t\t\t- ваш ⇒ ваше\n- gender endings #card\n  card-last-interval:: 4\n  card-repeats:: 1\n  card-ease-factor:: 2.36\n  card-next-schedule:: 2024-06-23T16:23:59.465Z\n  card-last-reviewed:: 2024-06-19T16:23:59.465Z\n  card-last-score:: 3\n\t- masculine\n\t\t- consonant\n\t\t- й\n\t\t- ь\n\t\t\t- only a few of them are masculine\n\t\t\t- день (day)\n\t\t- males, days, towns (except Москв**а**) and languages\n\t\t- exceptions: Кофе\n\t- feminine\n\t\t- а\n\t\t- я\n\t\t- ь\n\t\t\t- most of them are feminine\n\t\t\t- дверь (door), мать (mother)\n\t- neuter\n\t\t- o\n\t\t- e\n\t\t- и/у/ю\n\t\t\t- foreign words that are generally be neutral\n\t\t\t- такс**и** (taxi), мен**ю** (menu)\n\t\t- я (exceptions): вр**е**мя (time), **и**мя (name), пл**а**мя (flame)\n-\n- [[cases]]\n- [[verbs]]\n- [[nouns]]\n- [[plurals]]\n- [[pronouns]]\n- [[adjectives]]\n- adverbs\n\t- Adjectives can be turned into adverbs by replacing the masculine nominative endings (-ый/-ий/-**о**й) with -о\n\t- Adverbs are indeclinable\n- [[vocabulary]]\n\t- {{cards [[vocabulary]] }}\n\t\t- Summary: 15 items, 15 review counts [[2024-09-20]]\n\t\t\t- Remembered:   9 (60%)\n\t\t\t- Forgotten :   6 (40%)\n\t\t- Summary: 25 items, 25 review counts [[2024-09-19]]\n\t\t\t- Remembered:   16 (64%)\n\t\t\t- Forgotten :   9 (36%)\n\t\t- Summary: 24 items, 24 review counts [[2024-09-18]]\n\t\t\t- Remembered:   15 (62%)\n\t\t\t- Forgotten :   9 (37%)\n\t\t- Summary: 5 items, 5 review counts [[2024-09-17]]\n\t\t\t- Remembered:   5 (100%)\n\t\t\t- Forgotten :   0 (0%)\n\t\t- Summary: 17 items, 17 review counts [[2024-07-19]]\n\t\t\t- Remembered:   5 (29%)\n\t\t\t- Forgotten :   12 (70%)",536896353]],["^15",[123,"^19",1712993843481,536870919]],["^15",[123,"^1:","~m1726869170585",536896354]],["^15",[123,"^Z","pages/Russian.md",536870919]],["^15",[123,"^1;",2263,536904132]],["^15",[124,"^K",1712993843481,536870919]],["^15",[124,"^[",123,536870919]],["^15",[124,"^@",false,536870919]],["^15",[124,"^Y","russian",536870919]],["^15",[124,"^11","Russian",536870919]],["^15",[124,"^B",1726784895888,536895720]],["^15",[124,"^;","~u66fc6de7-3866-498d-9309-313c903481b4",536896364]],["^15",[125,"^Q","gender endings #card\ncard-last-interval:: 4\ncard-repeats:: 1\ncard-ease-factor:: 2.36\ncard-next-schedule:: 2024-06-23T16:23:59.465Z\nca