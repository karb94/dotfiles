,["^15",[2858,"^F",2865,536906344]],["^15",[2858,"^X",1475,536906344]],["^15",[2858,"^V",2865,536906344]],["^15",[2858,"^U",1475,536906344]],["^15",[2858,"^;","~u67b71e8a-b007-49d5-ae6f-2eb382bb04b8",536906344]],["^15",[2859,"^Q","Since gradients are column vectors, take the transpose:\n\\[ \\nabla_b f(b) = 2 X^T X b \\]\n\n**Final Answer:**\n\nThe derivative of \\( b^T X^T X b \\) with respect to \\( b \\) is:\n\n\\[\n\\boxed{2 X^\\top X b}\n\\]",536906344]],["^15",[2859,"^O","^16",536906344]],["^15",[2859,"^F",2855,536906344]],["^15",[2859,"^X",1475,536906344]],["^15",[2859,"^V",2865,536906344]],["^15",[2859,"^U",1475,536906344]],["^15",[2859,"^;","~u67b71e8a-6b21-413a-a8cc-9d97fde781e1",536906344]],["^15",[2860,"^Q","machine learning",536906344]],["^15",[2860,"^O","^16",536906344]],["^15",[2860,"^F",1477,536906344]],["^15",[2860,"^X",1475,536906344]],["^15",[2860,"^V",1475,536906344]],["^15",[2860,"^U",1475,536906344]],["^15",[2860,"^;","~u67b71e8a-f0cc-4e09-814c-0a9625928277",536906344]],["^15",[2861,"^Q","The derivative of \\( y^T y \\) with respect to \\( y \\) is \\( 2y \\).",536906344]],["^15",[2861,"^O","^16",536906344]],["^15",[2861,"^F",2869,536906344]],["^15",[2861,"^X",1475,536906344]],["^15",[2861,"^V",2865,536906344]],["^15",[2861,"^U",1475,536906344]],["^15",[2861,"^;","~u67b71e8a-403b-4531-bddd-34fc6e8bf516",536906344]],["^15",[2862,"^Q","\\( \\frac{dy}{db} = X \\).",536906344]],["^15",[2862,"^O","^16",536906344]],["^15",[2862,"^F",2867,536906344]],["^15",[2862,"^X",1475,536906344]],["^15",[2862,"^V",2865,536906344]],["^15",[2862,"^U",1475,536906344]],["^15",[2862,"^;","~u67b71e8a-137d-42eb-b5a5-57234a5bd8dc",536906344]],["^15",[2863,"^Q","[explained AI](https://explained.ai/)",536906344]],["^15",[2863,"^O","^16",536906344]],["^15",[2863,"^F",2853,536906344]],["^15",[2863,"^X",1475,536906344]],["^15",[2863,"^V",2853,536906344]],["^15",[2863,"^U",1475,536906344]],["^15",[2863,"^;","~u67b71e8a-52fe-4cc9-922d-6450d0fbfd6b",536906344]],["^15",[2864,"^Q","It represents the squared norm of the linear transformation \\( Xb \\), i.e., \\( \\|Xb\\|^2 \\).\n\n2. **Express Using Norms:**",536906344]],["^15",[2864,"^O","^16",536906344]],["^15",[2864,"^F",2858,536906344]],["^15",[2864,"^X",1475,536906344]],["^15",[2864,"^V",2865,536906344]],["^15",[2864,"^U",1475,536906344]],["^15",[2864,"^;","~u67b71e8a-adfa-410f-b481-81144c388ff5",536906344]],["^15",[2865,"^Q","To calculate the derivative of \\( f(b) = b^T X^T X b \\), we can use properties of quadratic forms and matrix calculus.\n\n**Step-by-Step Explanation:**\n\n1. **Understand the Function:**",536906344]],["^15",[2865,"^O","^16",536906344]],["^15",[2865,"^F",2866,536906344]],["^15",[2865,"^X",1475,536906344]],["^15",[2865,"^V",2866,536906344]],["^15",[2865,"^U",1475,536906344]],["^15",[2865,"^;","~u67b71e8a-3967-4254-b71e-b0c80dda2c73",536906344]],["^15",[2866,"^Q","Multivariate linear regression",536906344]],["^15",[2866,"^O","^16",536906344]],["^15",[2866,"^F",2860,536906344]],["^15",[2866,"^X",1475,536906344]],["^15",[2866,"^V",1475,536906344]],["^15",[2866,"^U",1475,536906344]],["^15",[2866,"^;","~u67b71e8a-06c3-4a0d-a9a3-70427b5e299f",536906344]],["^15",[2867,"^Q","\\( \\frac{df}{dy} = 2y^T \\) (row vector).",536906344]],["^15",[2867,"^O","^16",536906344]],["^15",[2867,"^F",2857,536906344]],["^15",[2867,"^X",1475,536906344]],["^15",[2867,"^V",2865,536906344]],["^15",[2867,"^U",1475,536906344]],["^15",[2867,"^;","~u67b71e8a-be95-4b2a-8317-235a41c33bb7",536906344]],["^15",[2868,"^Q","[matrix calculus](https://explained.ai/matrix-calculus/index.html)",536906344]],["^15",[2868,"^O","^16",536906344]],["^15",[2868,"^F",2863,536906344]],["^15",[2868,"^X",1475,536906344]],["^15",[2868,"^V",2863,536906344]],["^15",[2868,"^U",1475,536906344]],["^15",[2868,"^;","~u67b71e8a-1d16-4909-934f-a892fb1b9951",536906344]],["^15",[2869,"^Q","Let’s denote \\( y = Xb \\), then \\( f(b) = y^T y \\).",536906344]],["^15",[2869,"^O","^16",536906344]],["^15",[2869,"^F",2856,536906344]],["^15",[2869,"^X",1475,536906344]],["^15",[2869,"^V",2865,536906344]],["^15",[2869,"^U",1475,536906344]],["^15",[2869,"^;","~u67b71e8a-5459-47be-9df3-547da02da9ab",536906344]],["^15",[2870,"^Q","[[maths]]",536906347]],["^15",[2870,"^O","^16",536906347]],["^15",[2870,"^F",677,536906347]],["^15",[2870,"^X",163,536906347]],["^15",[2870,"^V",163,536906347]],["^15",[2870,"^U",163,536906348]],["^15",[2870,"^U",1475,536906348]],["^15",[2870,"^?",["^ "],536906347]],["^15",[2870,"^H",1475,536906347]],["^15",[2870,"^;","~u67b71eb3-bb4b-4d12-8546-0815e9923a21",536906347]],["^15",[2871,"^Q","[[machine learning]]",536906357]],["^15",[2871,"^O","^16",536906353]],["^15",[2871,"^F",2870,536906353]],["^15",[2871,"^X",163,536906353]],["^15",[2871,"^V",2870,536906361]],["^15",[2871,"^U",163,536906362]],["^15",[2871,"^U",1475,536906362]],["^15",[2871,"^U",2872,536906362]],["^15",[2871,"^?",["^ "],536906357]],["^15",[2871,"^H",2872,536906357]],["^15",[2871,"^;","~u67b71eb5-d8da-41b4-97e8-23c6e82bcf2d",536906353]],["^15",[2872,"^K",1740054205429,536906357]],["^15",[2872,"^[",2874,536906373]],["^15",[2872,"^O","^16",536906365]],["^15",[2872,"^@",false,536906357]],["^15",[2872,"^Y","machine learning",536906357]],["^15",[2872,"^11","machine learning",536906357]],["^15",[2872,"^B",1740258925254,536911090]],["^15",[2872,"^;","~u67b71ebd-a075-47ae-8c87-fd6dd1133abc",536906357]],["^15",[2873,"^Q","linear regression",536906376]],["^15",[2873,"^O","^16",536906366]],["^15",[2873,"^@",false,536906366]],["^15",[2873,"^F",2896,536907312]],["^15",[2873,"^X",2872,536906366]],["^15",[2873,"^V",2872,536906366]],["^15",[2873,"^U",2872,536906367]],["^15",[2873,"^?",["^ "],536906376]],["^15",[2873,"^;","~u67b71ecd-d0f3-4864-9284-ceb27be89f57",536906366]],["^15",[2874,"^3","- Residual Sum of Squares (RSS)\n  id:: 67b72a20-a339-41a2-834c-3b7650f40ec2\n\t- $\\displaystyle \\mathrm{RSS} = \\sum^n_{i=1} (y_i - \\hat y_i)^2$\n- Mean Squared Error (MSE)\n  id:: 67b72a96-b3e2-4372-a7e1-44dce410adaf\n\t- $\\displaystyle \\mathrm{MSE} = \\frac{\\mathrm{RSS}}{n} = \\frac{1}{n}\\sum^n_{i=1} (y_i - \\hat y_i)^2$\n- linear regression\n\t- scalar form\n\t\t- $\\displaystyle y_i = \\beta_0 + \\sum^p_{j=1} x_{ij} \\beta_j + \\epsilon_i$\n\t\t- for $i \\in \\{1, ..., n\\}$\n\t\t- where\n\t\t\t- $y$ is the _response_\n\t\t\t- $\\beta_0$ is the intercept (or _bias_ in Machine Learning)\n\t\t\t- $x_{ij} is the _j_-th predictor of the _i_-th observation\n\t\t\t- $\\beta_j$ is the _j_-th weight of the _j_-th _predictor_\n\t\t\t- $\\epsilon_i \\overset{\\mathrm{iid}}{\\sim} N(0, \\sigma^2)$ is a normally distributed random variable with $E(\\epsilon_i) = 0$ (otherwise the excess can go into $\\beta_0$)\n\t- Matrix form\n\t\t- $\\bm{y} = \\beta_0 + \\bm{X} \\bm{\\beta} + \\bm{\\epsilon}$\n\t\t- where\n\t\t\t- $$\n\t\t\t  \\bm{y} = \\left[ \\begin{matrix} y_1 \\\\ y_2 \\\\ \\vdots \\\\ y_n \\\\ \\end{matrix} \\right] \\quad\n\t\t\t  \\bm{X} = \\left[ \\begin{matrix}\n\t\t\t  x_{11} & x_{12}  & \\dots & x_{1p} \\\\\n\t\t\t  x_2 &  x_{22}  & \\dots & x_{1p} \\\\\n\t\t\t  \\vdots &  \\vdots  & \\ddots & \\vdots \\\\\n\t\t\t  x_{n1} & x_{n2}  & \\dots & x_{np} \\\\\n\t\t\t  \\end{matrix} \\right]  \\quad\n\t\t\t  \\bm{\\beta} = \\left[ \\begin{matrix} \\beta_1 \\\\ \\beta_2 \\\\ \\vdots \\\\ \\beta_p \\\\ \\end{matrix} \\right] \\quad\n\t\t\t  \\bm{\\epsilon} = \\left[ \\begin{matrix} \\epsilon_1 \\\\ \\epsilon_2 \\\\ \\vdots \\\\ \\epsilon_n \\\\ \\end{matrix} \\right] \\quad\n\t\t\t  $$\n\t\t\t- $n$h is the number of observations\n\t\t\t- $p$ is the number of predictors\n\t\t\t- $\\beta_0$ is the intercept (or _bias_ in Machine Learning)\n\t\t- We can simplify the equation by incorporating $\\beta_0$ in $\\bm{\\beta}$ and inserting a column of $1$s as the first column in $\\bm{X}$\n\t\t\t- $\\bm{y} = \\bm{X} \\bm{\\beta} + \\bm{\\epsilon}$\n\t\t\t- where\n\t\t\t\t- $$\n\t\t\t\t  \\bm{X} = \\left[ \\begin{matrix}\n\t\t\t\t  1 & x_{11} & x_{12}  & \\dots & x_{1p} \\\\\n\t\t\t\t  1 & x_2 &  x_{22}  & \\dots & x_{1p} \\\\\n\t\t\t\t  \\vdots &  \\vdots  & \\ddots & \\vdots \\\\\n\t\t\t\t  1 & x_{n1} & x_{n2}  & \\dots & x_{np} \\\\\n\t\t\t\t  \\end{matrix} \\right]  \\quad\n\t\t\t\t  \\bm{\\beta} = \\left[ \\begin{matrix} \\beta_0 \\\\ \\beta_1 \\\\ \\beta_2 \\\\ \\vdots \\\\ \\beta_p \\\\ \\end{matrix} \\right] \\quad\n\t\t\t\t  $$\n\t- estimator\n\t\t- $\\displaystyle \\hat y_i = \\beta_0 + \\sum^p_{j=1} x_{ij} \\beta_j$\n\t\t- $\\bm{\\hat y} = \\bm{X} \\bm{\\beta}$\n\t- We want to minimize the ((67b72a20-a339-41a2-834c-3b7650f40ec2)) or, equivalently, the ((67b72a96-b3e2-4372-a7e1-44dce410adaf))\n\t\t- $$\n\t\t  \\begin{aligned}\n\t\t  \\displaystyle \\mathrm{RSS}(\\bm{\\beta})\n\t\t  &= \\bm{\\epsilon}^T \\bm{\\epsilon} = (\\bm{y} - \\bm{X} \\bm{\\beta})^2 \\\\\n\t\t  &= (\\bm{y} - \\bm{X} \\bm{\\beta})^T (\\bm{y} - \\bm{X} \\bm{\\beta}) \\\\\n\t\t  &= (\\bm{y}^T - (\\bm{X} \\bm{\\beta})^T) (\\bm{y} - \\bm{X} \\bm{\\beta}) \\\\\n\t\t  &= \\bm{y}^T \\bm{y} - (\\bm{X} \\bm{\\beta})^T \\bm{y} - \\bm{y}^T \\bm{X} \\bm{\\beta} + (\\bm{X} \\bm{\\beta})^T \\bm{X} \\bm{\\beta} \\\\\n\t\t  &= \\bm{y}^T \\bm{y} - \\bm{y}^T \\bm{X} \\bm{\\beta} - \\bm{y}^T \\bm{X} \\bm{\\beta} + (\\bm{X} \\bm{\\beta})^T \\bm{X} \\bm{\\beta} \\\\\n\t\t  &= \\bm{y}^T \\bm{y} - 2\\bm{y}^T \\bm{X} \\bm{\\beta} + (\\bm{X} \\bm{\\beta})^T \\bm{X} \\bm{\\beta} \\\\\n\t\t  \\end{aligned}\n\t\t  $$\n\t\t- note that\n\t\t\t- $\\bm{a}^T \\bm{b} = \\bm{b}^T \\bm{a}$ where $\\bm{a}$ and $\\bm{b}$ are vectors\n\t\t\t\t- $\\bm{X} \\bm{\\beta}$ is a column vector\n\t\t\t\t- Therefore, $(\\bm{X} \\bm{\\beta})^T \\bm{y} = \\bm{y}^T (\\bm{X} \\bm{\\beta})$\n\t\t- $$\n\t\t  \\begin{aligned}\n\t\t  \\frac{\\partial RSS}{\\partial \\bm{\\beta}}\n\t\t  &= \\frac{\\partial}{\\partial \\bm{\\beta}} \\bm{y}^T \\bm{y}\n\t\t  - \\frac{\\partial}{\\partial \\bm{\\beta}} 2\\bm{y}^T \\bm{X} \\bm{\\beta}\n\t\t  + \\frac{\\partial}{\\partial \\bm{\\beta}} (\\bm{X} \\bm{\\beta})^T \\bm{X} \\bm{\\beta} \\\\\n\t\t  &= 0 - 2\\bm{X}^T \\bm{y} + 2 \\bm{X}^T \\bm{X} \\bm{\\beta}\n\t\t  \\end{aligned}\n\t\t  $$\n\t\t- note that\n\t\t\t- $\\displaystyle \\frac{\\partial \\bm{a}^T \\bm{x}}{\\partial \\bm{x}} = \\frac{\\partial \\bm{x}^T \\bm{a}}{\\partial \\bm{x}} = \\bm{a^T}$\n\t\t\t\t- where $\\bm{a}$ is not a function of $\\bm{x}\n\t\t\t\t- The result is a row vector because we are following the numerator layout convention\n\t\t\t\t- $2\\bm{y}^T \\bm{X}$ is a row vector\n\t\t\t- product rule\n\t\t\t\t- $\\displaystyle \\frac{\\partial \\bm{u}^T \\bm{v}}{\\partial \\bm{x}} = \\frac{\\partial \\bm{v}^T \\bm{u}}{\\partial \\bm{x}} = \\bm{u}^T \\frac{\\partial \\bm{v}}{\\partial \\bm{x}} + \\bm{v}^T \\frac{\\partial \\bm{u}}{\\partial \\bm{x}}$\n\t\t\t\t- where $\\bm{u}$ and $\\bm{v}$ are functions of $\\bm{x}$\n\t\t\t\t- when $\\bm{u} = \\bm{v}$\n\t\t\t\t\t- $\\displaystyle \\frac{\\partial \\bm{u}^T \\bm{u}}{\\partial \\bm{x}} = \\bm{u}^T \\frac{\\partial \\bm{u}}{\\partial \\bm{x}} + \\bm{u}^T \\frac{\\partial \\bm{u}}{\\partial \\bm{x}} = 2 \\bm{u}^T \\frac{\\partial \\bm{u}}{\\partial \\bm{x}}$\n\t\t\t\t- $\\displaystyle \\frac{\\partial \\bm{x}^T \\bm{x}}{\\partial \\bm{x}} = \\bm{x}^T \\frac{\\partial \\bm{x}}{\\partial \\bm{x}} + \\bm{x}^T \\frac{\\partial \\bm{x}}{\\partial \\bm{x}} = 2 \\bm{x}^T$\n\t\t\t\t-\n\t\t\t- chain rule\n\t\t\t\t- $\\displaystyle \\frac{\\partial \\bm{g}(\\bm{f}(x))}{\\partial \\bm{x}} = \\frac{\\partial \\bm{g}}{\\partial \\bm{f}} \\frac{\\partial \\bm{f}}{\\partial \\bm{x}}$\n\t\t\t- Let $\\bm{f}(\\beta) = \\bm{X} \\bm{\\beta}; \\quad \\bm{g}(\\bm{f}) = \\bm{f}^T \\bm{f}$\n\t\t\t\t- $$\n\t\t\t\t  \\begin{aligned}\n\t\t\t\t  \\displaystyle \\frac{\\partial}{\\partial \\bm{\\beta}}\n\t\t\t\t  (\\bm{X} \\bm{\\beta})^T \\bm{X} \\bm{\\beta}\n\t\t\t\t  &= \\frac{\\partial}{\\partial \\bm{\\beta}} \\bm{f}^T \\bm{f}\n\t\t\t\t  = \\frac{\\partial}{\\partial \\bm{\\beta}} \\bm{g} \\\\\n\t\t\t\t  &= \\frac{\\partial \\bm{g}}{\\partial \\bm{f}} \\frac{\\partial \\bm{f}}{\\partial \\bm{\\beta}}\n\t\t\t\t  = \\frac{\\partial (\\bm{f}^T \\bm{f})}{\\partial \\bm{f}} \\frac{\\partial \\bm{f}}{\\partial \\bm{\\beta}} \\\\\n\t\t\t\t  &= 2 \\bm{f}^T \\frac{\\partial \\bm{f}}{\\pk\\beta}}\n\t\t\t\t  = 2 (\\bm{X} \\bm{\\beta})^T  \\frac{\\partial (\\bm{X} \\bm{\\beta})}{\\partial \\bm{\\beta}} \\\\\n\t\t\t\t  &= 2 \\bm{\\beta}^T \\bm{X}^T \\left( \\bm{X}\\frac{\\partial \\bm{\\beta}}{\\partial \\bm{\\beta}} \\right) \\\\\n\t\t\t\t  &= 2 \\bm{\\beta}^T \\bm{X}^T \\bm{X}\n\t\t\t\t  \\end{aligned}\n\t\t\t\t  $$\n\t\t\t\t- The result is different if you follow the denominator layout convention\n\t-",536911092]],["^15",[2874,"^1:","~m1740258925874",536911091]],["^15",[2874,"^Z","pages/machine learning.md",536906373]],["^15",[2875,"^Q","note that",536909056]],["^15",[2875,"^O","^16",536906376]],["^15",[2875,"^@",false,536906376]],["^15",[2875,"^F",2899,536909046]],["^15",[2875,"^X",2872,536906376]],["^15",[2875,"^V",2922,536909046]],["^15",[2875,"^U",2872,536909047]],["^15",[2875,"^U",2893,536909047]],["^15",[2875,"^U",2896,536909047]],["^15",[2875,"^?",["^ "],536909056]],["^15",[2875,"^;","~u67b71f5f-f5e1-4536-b22a-78f6999f44c2",536906376]],["^15",[2880,"^Q","",536906489]],["^15",[2880,"^O","^16",536906489]],["^15",[2880,"^@",false,536906489]],["^15",[2880,"^F",2922,536909046]],["^15",[2880,"^X",2872,536906489]],["^15",[2880,"^V",2873,536906489]],["^15",[2880,"^U",2872,536907313]],["^15",[2880,"^?",["^ "],536906489]],["^15",[2880,"^;","~u67b722b8-e002-4753-b2e9-f61d0693ac88",536906489]],["^15",[2881,"^Q","$\\displaystyle y_i = \\beta_0 + \\sum^p_{j=1} x_{ij} \\beta_j + \\epsilon_i$",536906867]],["^15",[2881,"^O","^16",536906575]],["^15",[2881,"^@",false,536906575]],["^15",[2881,"^F",2882,536906623]],["^15",[2881,"^X",2872,536906575]],["^15",[2881,"^V",2882,536906633]],["^15",[2881,"^U",2872,536908524]],["^15",[2881,"^?",["^ "],536906867]],["^15",[2881,"^;","~u67b723a8-8c3a-477b-9fbe-7203fb877199",536906575]],["^15",[2882,"^Q","scalar form",536