8,"^@",false,536903243]],["^15",[2638,"^F",2637,536903243]],["^15",[2638,"^X",2567,536903243]],["^15",[2638,"^V",2634,536903243]],["^15",[2638,"^U",2567,536903767]],["^15",[2638,"^;","~u6787cec7-985f-48ca-a502-51ac90cc2ab8",536903243]],["^15",[2639,"^Q","",536903310]],["^15",[2639,"^O","^16",536903310]],["^15",[2639,"^@",false,536903310]],["^15",[2639,"^F",2646,536906341]],["^15",[2639,"^X",2567,536903310]],["^15",[2639,"^V",2640,536906341]],["^15",[2639,"^U",2567,536903311]],["^15",[2639,"^;","~u6787d555-a529-44ee-986f-8e288770b12f",536903310]],["^15",[2640,"^Q","QE is thought to stimulate economic activity and inflation by",536903364]],["^15",[2640,"^O","^16",536903314]],["^15",[2640,"^@",false,536903314]],["^15",[2640,"^F",2638,536903732]],["^15",[2640,"^X",2567,536903314]],["^15",[2640,"^V",2634,536903314]],["^15",[2640,"^U",2567,536903767]],["^15",[2640,"^;","~u6787d9a4-11b2-47f4-8b29-e67a1bfe0cd3",536903314]],["^15",[2641,"^Q","portfolio rebalancing",536903380]],["^15",[2641,"^O","^16",536903367]],["^15",[2641,"^@",false,536903367]],["^15",[2641,"^F",2640,536903367]],["^15",[2641,"^X",2567,536903367]],["^15",[2641,"^V",2640,536903369]],["^15",[2641,"^U",2567,536903767]],["^15",[2641,"^;","~u6787d9f7-1bdb-47ab-a500-9f3b2fc3e440",536903367]],["^15",[2642,"^Q","Investors invest in other assets (hopefully productive ones)",536903565]],["^15",[2642,"^O","^16",536903383]],["^15",[2642,"^@",false,536903383]],["^15",[2642,"^F",2643,536903538]],["^15",[2642,"^X",2567,536903383]],["^15",[2642,"^V",2641,536903385]],["^15",[2642,"^U",2567,536903767]],["^15",[2642,"^;","~u6787da01-97ce-433b-9f99-943eb68534eb",536903383]],["^15",[2643,"^Q","Less gilts in circulation increases their price and reduces their yield becoming a less attractive asset for investors",536903535]],["^15",[2643,"^O","^16",536903435]],["^15",[2643,"^@",false,536903435]],["^15",[2643,"^F",2641,536903538]],["^15",[2643,"^X",2567,536903435]],["^15",[2643,"^V",2641,536903435]],["^15",[2643,"^U",2567,536903767]],["^15",[2643,"^;","~u6787da55-b95c-4e5d-9f11-32d958cf6f8a",536903435]],["^15",[2644,"^Q","market liquidity",536903578]],["^15",[2644,"^O","^16",536903568]],["^15",[2644,"^@",false,536903568]],["^15",[2644,"^F",2641,536903570]],["^15",[2644,"^X",2567,536903568]],["^15",[2644,"^V",2640,536903570]],["^15",[2644,"^U",2567,536903767]],["^15",[2644,"^;","~u6787db2d-fbc6-4559-9f38-4d188447db4e",536903568]],["^15",[2645,"^Q","By adding a major buyer to the market, QE improves liquidity which reduces the yield of the gilts",536903618]],["^15",[2645,"^O","^16",536903579]],["^15",[2645,"^@",false,536903579]],["^15",[2645,"^F",2644,536903579]],["^15",[2645,"^X",2567,536903579]],["^15",[2645,"^V",2644,536903585]],["^15",[2645,"^U",2567,536903767]],["^15",[2645,"^;","~u6787db34-52c1-4241-b1d7-813c1270d6f0",536903579]],["^15",[2646,"^Q","signalling",536903631]],["^15",[2646,"^O","^16",536903621]],["^15",[2646,"^@",false,536903621]],["^15",[2646,"^F",2644,536903625]],["^15",[2646,"^X",2567,536903621]],["^15",[2646,"^V",2640,536903625]],["^15",[2646,"^U",2567,536903767]],["^15",[2646,"^;","~u6787dbbc-f4fa-492d-a159-f43df8c13603",536903621]],["^15",[2647,"^Q","Signals the market that the Bank intends to maintain low interest rates for an extended period of time",536903680]],["^15",[2647,"^O","^16",536903634]],["^15",[2647,"^@",false,536903634]],["^15",[2647,"^F",2646,536903634]],["^15",[2647,"^X",2567,536903634]],["^15",[2647,"^V",2646,536903638]],["^15",[2647,"^U",2567,536903767]],["^15",[2647,"^;","~u6787dbc2-02bf-491a-9659-c0ef21971abf",536903634]],["^15",[2648,"^Q","If investors have confidence that BoE will do whatever is necessary to control inflation they can be content with a lower gilt yield",536903727]],["^15",[2648,"^O","^16",536903683]],["^15",[2648,"^@",false,536903683]],["^15",[2648,"^F",2647,536903683]],["^15",[2648,"^X",2567,536903683]],["^15",[2648,"^V",2646,536903683]],["^15",[2648,"^U",2567,536903767]],["^15",[2648,"^;","~u6787dc46-60d8-434b-9895-109c8cdbf643",536903683]],["^15",[2649,"^Q","Important read: [UK Parliament: Quantitative Tightening report](https://publications.parliament.uk/pa/cm5804/cmselect/cmtreasy/219/report.html)",536903883]],["^15",[2649,"^O","^16",536903730]],["^15",[2649,"^@",false,536903730]],["^15",[2649,"^F",2651,536903836]],["^15",[2649,"^X",2567,536903730]],["^15",[2649,"^V",2638,536903732]],["^15",[2649,"^U",2567,536903783]],["^15",[2649,"^;","~u6787de61-11d3-4045-9778-56393fa1dbb3",536903730]],["^15",[2651,"^Q","They do it in a way that (in theory) doesn't affect the economy in any way",536903826]],["^15",[2651,"^O","^16",536903786]],["^15",[2651,"^@",false,536903786]],["^15",[2651,"^F",2638,536903786]],["^15",[2651,"^X",2567,536903786]],["^15",[2651,"^V",2638,536903786]],["^15",[2651,"^U",2567,536903787]],["^15",[2651,"^;","~u6787dfac-90bf-4feb-a530-656e8693db26",536903786]],["^15",[2653,"^Q","Other Central banks like the Fed and ECB have plans to do this",536903895]],["^15",[2653,"^O","^16",536903839]],["^15",[2653,"^@",false,536903839]],["^15",[2653,"^F",2649,536903839]],["^15",[2653,"^X",2567,536903839]],["^15",[2653,"^V",2638,536903839]],["^15",[2653,"^U",2567,536903840]],["^15",[2653,"^;","~u6787dfdb-2cd9-4e7d-8868-b222ae21f053",536903839]],["^15",[2654,"^12",2,536903899]],["^15",[2655,"^Q","The underlying stochastic variable can be the price of a commodity, a stock, the value of a currency exchange rate",536904040]],["^15",[2655,"^O","^16",536903927]],["^15",[2655,"^F",2549,536904307]],["^15",[2655,"^X",537,536903927]],["^15",[2655,"^V",2548,536904310]],["^15",[2655,"^U",537,536903932]],["^15",[2655,"^?",["^ "],536904307]],["^15",[2655,"^;","~u678d2790-1516-4e49-87cf-989915f16a59",536903927]],["^15",[2657,"^K",1737305427473,536904062]],["^15",[2657,"^[",2664,536904099]],["^15",[2657,"^O","^16",536904062]],["^15",[2657,"^@",false,536904062]],["^15",[2657,"^Y","stochastic process",536904062]],["^15",[2657,"^11","stochastic process",536904062]],["^15",[2657,"^B",1737309298616,536904326]],["^15",[2657,"^;","~u678d2d53-1b66-4d93-909f-7f1327bbf960",536904062]],["^15",[2658,"^Q","Stochastic process\nid:: 6779c61a-b203-4049-9b5e-1b70d517c5de",536904069]],["^15",[2658,"^U",2465,536904069]],["^15",[2658,"^?",["^ ","^1G","6779c61a-b203-4049-9b5e-1b70d517c5de"],536904069]],["^15",[2658,"^J",["^14",["^1G"]],536904069]],["^15",[2658,"^4",["^ ","^1G","6779c61a-b203-4049-9b5e-1b70d517c5de"],536904069]],["^15",[2658,"^;","~u6779c61a-b203-4049-9b5e-1b70d517c5de",536904069]],["^15",[2659,"^Q","Any variable whose value changes over time in an uncertain way",536904069]],["^15",[2659,"^O","^16",536904069]],["^15",[2659,"^F",2658,536904069]],["^15",[2659,"^X",2657,536904069]],["^15",[2659,"^V",2658,536904069]],["^15",[2659,"^U",2465,536904069]],["^15",[2659,"^?",["^ "],536904069]],["^15",[2659,"^;","~u6779c62a-8e29-42db-8f5e-c74d2e36e51e",536904069]],["^15",[2660,"^Q","Markov process\nid:: 6779beb2-03a4-4200-84cd-96002dd58cfa",536904069]],["^15",[2660,"^O","^16",536904069]],["^15",[2660,"^F",2658,536904069]],["^15",[2660,"^X",2657,536904069]],["^15",[2660,"^V",2657,536904069]],["^15",[2660,"^U",2465,536904069]],["^15",[2660,"^?",["^ ","^1G","6779beb2-03a4-4200-84cd-96002dd58cfa"],536904069]],["^15",[2660,"^J",["^14",["^1G"]],536904069]],["^15",[2660,"^4",["^ ","^1G","6779beb2-03a4-4200-84cd-96002dd58cfa"],536904069]],["^15",[2660,"^;","~u6779beb2-03a4-4200-84cd-96002dd58cfa",536904069]],["^15",[2661,"^Q","Type of ((6779c61a-b203-4049-9b5e-1b70d517c5de)) where only the current value of a variable is relevant for predicting the future",536904069]],["^15",[2661,"^O","^16",536904069]],["^15",[2661,"^F",2660,536904069]],["^15",[2661,"^X",2657,536904069]],["^15",[2661,"^V",2660,536904069]],["^15",[2661,"^U",2465,536904069]],["^15",[2661,"^U",2479,536904069]],["^15",[2661,"^?",["^ "],536904069]],["^15",[2661,"^H",2479,536904069]],["^15",[2661,"^;","~u6779bd95-32df-4506-b011-58f02ee5c9e3",536904069]],["^15",[2662,"^Q","The past history of the variable and the way that the present has emerged from the past are irrelevant",536904069]],["^15",[2662,"^O","^16",536904069]],["^15",[2662,"^F",2661,536904069]],["^15",[2662,"^X",2657,536904069]],["^15",[2662,"^V",2661,536904069]],["^15",[2662,"^U",2465,536904069]],["^15",[2662,"^U",2479,536904069]],["^15",[2662,"^?",["^ "],536904069]],["^15",[2662,"^;","~u6779beff-a1ce-43d2-9157-2576491e6b29",536904069]],["^15",[2664,"^3","- Any variable whose value changes over time in an uncertain way\n- Markov process\n  id:: 034a3370-86b0-4714-bc5b-6aad21aa7f75\n\t- Type of ((6779c61a-b203-4049-9b5e-1b70d517c5de)) where only the current value of a variable is relevant for predicting the future\n\t\t- The past history of the variable and the way that the present has emerged from the past are irrelevant\n- Wiener process\n  id:: 678d39c2-e243-4e29-8026-818e987b4810\n\t- Type of ((034a3370-86b0-4714-bc5b-6aad21aa7f75)) with a mean change of zero and a variance rate of 1 per year\n\t- Also known as Brownian motion\n\t- properties\n\t\t- The change $dz$ during a small period of time $dt$ is $dz = \\epsilon \\sqrt{dt}$ where $\\epsilon = \\mathcal{N} (0, 1)$\n\t\t  logseq.order-list-type:: number\n\t\t\t- Thus, $dz$ itself has a normal distribution $\\mathcal{N} (0, dt)$\n\t\t- The values of $dz$ for any two different short intervals of time, $dt$, are independent\n\t\t  logseq.order-list-type:: number\n\t\t\t- Thus, $z$ itself is also a Markov process\n- Generalized Wiener process\n  id:: 76f9cd9b-8fe6-4550-8152-3177dfaef1ed\n\t- A more general ((678d39c2-e243-4e29-8026-818e987b4810)) consisting of two components\n\t\t- drift rate\n\t\t- variance rate\n\t- For a variable $x$ the process is defined as\n\t\t- $dx = a \\, dt + b \\, dz$\n\t\t- where\n\t\t\t- $a$ is the drift rate\n\t\t\t- $b^2$ is the variance rate\n\t\t\t- $dz$ is a basic ((678d39c2-e243-4e29-8026-818e987b4810)) with no drift and a variance rate of 1\n\t\t- expanding $dz$, $dx = a \\, dt + b \\, \\epsilon \\sqrt{dt}$\n\t\t\t- Thus, $dx$ has a normal distribution $\\mathcal{N}(0, b^2dt)$\n- Itô process\n  id:: d133a8fb-2f1f-464a-8b9d-4712bf3acb7d\n\t- ((76f9cd9b-8fe6-4550-8152-3177dfaef1ed)) in which the drift ($a$) and variance ($b^2$) rates are functions of the value of the underlying variable $x$ and time $t$.\n\t- $dx = a(x,t) \\, dt + b(x,t) \\, dz$\n\t- This is still a ((034a3370-86b0-4714-bc5b-6aad21aa7f75)) as it only depends on the present value of the underlying variable and not its history\n- Itô lemma\n  id:: 678d3bcc-03b2-4fbd-a783-857ab95d7f01\n\t- Suppose that the value of a variable $x$ follows the ((d133a8fb-2f1f-464a-8b9d-4712bf3acb7d))\n\t\t- $dx = a(x, t) \\, dt + b(x,t) \\, dz$\n\t\t- where\n\t\t\t- $a$ is the drift rate\n\t\t\t- $b^2$ is the variance\n\t\t\t- $dz$ is a Wiener process\n\t- It can be proved that a function $G(x, t)$ follows the process\n\t\t- $dG = (\\frac{\\partial G}{\\partial x} a + \\frac{\\partial G}{\\partial t} + \\frac{1}{2} \\frac{\\partial^2 G}{\\partial x^2} b^2) \\, dt + \\frac{\\partial G}{\\partial x} b \\, dz$\n\t\t- where\n\t\t\t- $\\frac{\\partial G}{\\partial x} a + \\frac{\\partial G}{\\partial t} + \\frac{1}{2} \\frac{\\partial^2 G}{\\partial x^2} b^2$ is the drift rate\n\t\t\t- $(\\frac{\\partial G}{\\partial x})^2 b^2$ is the variance\n\t\t\t- $dz$ is the Wiener process of $G$ which is the same source of uncertainty as the underlying stochastic variable $x$\n\t- In finance, the underlying stochastic variable can be the price of a commodity, a stock, the value of a currency exchange rate",536904328]],["^15",[2664,"^1:","~m1737309298947",536904327]],["^15",[2664,"^Z","pages/stochastic process.md",536904099]],["^15",[2664,"^1;",321,536904132]],["^15",[2666,"^Q","Markov process\nid:: 034a3370-86b0-4714-bc5b-6aad21aa7f75",536904169]],["^15",[2666,"^O","^16",536904102]],["^15",[2666,"^F",2669,536904129]],["^15",[2666,"^X",2657,536904102]],["^15",[2666,"^V",2657,536904102]],["^15",[2666,"^U",2465,536904102]],["^15",[2666,"^?",["^ ","^1G","034a3370-86b0-4714-bc5b-6aad21aa7f75"],536904169]],["^15",[2666,"^J",["^14",["^1G"]],536904129]],["^15",[2666,"^4",["^ ","^1G","034a3370-86b0-4714-bc5b-6aad21aa7f75"],536904169]],["^15",[2666,"^;","~u034a3370-86b0-4714-bc5b-6aad21aa7f75",536904102]],["^15",[2667,"^Q","Type of ((6779c61a-b203-4049-9b5e-1b70d517c5de)) where only the current value of a variable is relevant for predicting the future",536904102]],["^15",[2667,"^O","^16",536904102]],["^15",[2667,"^F",2666,536904102]],["^15",[2667,"^X",2657,536904102]],["^15",[2667,"^V",2666,536904102]],["^15",[2667,"^U",2465,536904102]],["^15",[2667,"^U",2479,536904102]],["^15",[2667,"^?",["^ "],536904102]],["^15",[2667,"^H",2479,536904102]],["^15",[2667,"^;","~u4a245f04-1e9b-4c58-b3c8-ac1ae91b08e0",536904102]],["^15",[2668,"^Q","The past history of the variable and the way that the present has emerged from the past are irrelevant",536904102]],["^15",[2668,"^O","^16",536904102]],["^15",[2668,"^F",2667,536904102]],["^15",[2668,"^X",2657,536904102]],["^15",[2668,"^V",2667,536904102]],["^15",[2668,"^U",2465,536904102]],["^15",[2668,"^U",2479,536904102]],["^15",[2668,"^?",["^ "],536904102]],["^15",[2668,"^;","~ue272b3ed-fc06-4d1c-b013-a6708a9abe1c",536904102]],["^15",[2669,"^Q","Any variable whose value changes over time in an uncertain way",536904126]],["^15",[2669,"^O","^16",536904111]],["^15",[2669,"^F",2657,536904119]],["^15",[2669,"^X",2657,536904111]],["^15",[2669,"^V",2657,536904111]],["^15",[2669,"^U",2657,536904123]],["^15",[2669,"^?",["^ "],536904126]],["^15",[2669,"^;","~uf37037bd-9b50-4a79-a2aa-b9da00f63f1e",536904111]],["^15",[2674,"^12",2,536904108]],["^15",[2675,"^3","",536904132]],["^15",[2675,"^1:","~m1717068352212",536904132]],["^15",[2675,"^Z","logseq/custom.css",536904132]],["^15",[2675,"^1;",0,536904132]],["^15",[2676,"^Q","Wiener process\nid:: 678d39c2-e243-4e29-8026-818e987b4810",536904214]],["^15",[2676,"^O","^16",536904146]],["^15",[2676,"^F",2666,536904151]],["^15",[2676,"^X",2657,536904146]],["^15",[2676,"^V",2657,53690