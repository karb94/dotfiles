,[]],536883924]],["^15",[1583,"^@",false,536881483]],["^15",[1583,"^F",1582,536881483]],["^15",[1583,"^X",1582,536881483]],["^15",[1583,"^V",1582,536881483]],["^15",[1583,"^U",221,536881487]],["^15",[1583,"^U",1582,536881487]],["^15",[1583,"^:",true,536883924]],["^15",[1583,"^?",["^ ","^17",["^18",["sysadmin"]]],536883924]],["^15",[1583,"^J",["^17"],536883924]],["^15",[1583,"^4",["^ ","^17","sysadmin"],536883924]],["^15",[1583,"^H",221,536883924]],["^15",[1583,"^;","~u66ae3499-b56a-41f6-a01d-302eeb6a4a57",536881483]],["^15",[1584,"^Q","instances",536882055]],["^15",[1584,"^O","^16",536881488]],["^15",[1584,"^@",false,536881488]],["^15",[1584,"^F",1583,536882369]],["^15",[1584,"^X",1582,536881488]],["^15",[1584,"^V",1582,536881488]],["^15",[1584,"^U",1582,536881489]],["^15",[1584,"^;","~u66ae349f-ca1c-4f4f-a8f6-1afc0f50912b",536881488]],["^15",[1585,"^3","tags:: sysadmin\n\n- instances\n\t- system-wide\n\t\t- Always running (PID 1)\n\t\t- System-level services\n\t\t- Required root permissions\n\t\t- Units are generally stored under `/etc/systemd/system/` ([System Unit Search Path](https://man7.org/linux/man-pages/man5/systemd.unit.5.html))\n\t- per-user\n\t\t- Started/stopped upon user logon/logoff\n\t\t- When the instance starts it brings up the per-user target `default.target`\n\t\t- Singleton. Only one instance per user\n\t\t- Create units for current user\n\t\t\t- Requires user permissions\n\t\t\t- Generally stored under `$HOME/.config/systemd/user` ([User Unit Search Path](https://man7.org/linux/man-pages/man5/systemd.unit.5.html))\n\t\t- Create units for every user\n\t\t\t- Requires root permissions\n\t\t\t- Stored under `/etc/systemd/user/` ([User Unit Search Path](https://man7.org/linux/man-pages/man5/systemd.unit.5.html))\n\t\t\t- Enable/disable  units by using the `--global` flag\n\t\t\t\t- Example: `systemctl --global enable UNIT`\n-\n- Units\n\t- `man systemd.unit`\n\t- target-units\n\t\t- Logical collection of other system units\n\t\t- Some of them are used to emulate the _run-level_ equivalent in the _Sysinit_ init (legacy) system\n\t\t\t- `poweroff.target`: system shutdown\n\t\t\t- `reboot.target`: system reboot\n\t\t\t- `rescue.target`: single user mode for maintenance and recovery. Only the root account is allowed to log in. Networking is not available in this mode\n\t\t\t- `multi-user.target`: users can login\n\t\t\t- `graphical.target`: users have access to a graphical environment\n\t\t- common target units\n\t\t\t- `default.target`: an alias for `multi-user.target` (or more rarely`graphical.target`)\n\t\t\t- [network targets](https://www.freedesktop.org/wiki/Software/systemd/NetworkTarget/)\n\t\t\t- [Network Configuration Synchronization Points](https://systemd.io/NETWORK_ONLINE/)\n\t- `[Unit]` section options\n\t  id:: 66ae4e17-ee5a-4515-bd02-836e481ef187\n\t\t- The options `Wants=`, `Requires`=, `Requisite=`, or `BindsTo=` define when the unit starts, i.e. dependencies on other units/targets\n\t\t- The options `Before=`, and `After=` define the starting order once they\n\t\t- `Wants=`\n\t\t\t- List of units, but usually _target-units_ (`unit.target`)\n\t\t\t- Used to group units that should start at the same time\n\t\t\t\t- Does not imply a dependency on each other\n\t\t\t\t\t- If the listed units fail to start the unit will still start anyways\n\t\t\t- Starting order can be specified using the `Before=`  or `After=` options\n\t\t\t- most used targets\n\t\t\t\t- `multi-user.target`\n\t\t\t\t- `graphical.target`\n\t\t\t- Alternatively, place the unit under a `.wants/` directory\n\t\t\t- From the official documentation\n\t\t\t\t- >This is the recommended way to hook the start-up of one unit to the start-up of another unit\n\t\t- `Requires=`\n\t\t\t- Similar to `Wants=` but with a hard dependency\n\t\t\t- If any of these units is also specified in `After=` and they fail to activate, this unit will not be started\n\t\t\t- If any of these units is explicitly stopped/restarted, this unit will be stopped/restarted\n\t\t\t\t- Does not imply that these units must be always in active state when this unit is running\n\t\t\t\t- Units that deactivate on their on their own are exempt of this\n\t\t\t\t- Use `BindsTo=` + `After=` options to ensure that a unit will never be active when a specific unit isn't active\n\t\t\t- From the official documentation\n\t\t\t\t- >Often, it is a better choice to use *Wants=* instead of *Requires=* in order to achieve a system that is more robust when dealing with failing services\n\t\t- `Before=`/`After=`\n\t\t\t- They affect the starting order\n\t\t\t- A unit won't start until the previous unit has finished starting up\n\t\t\t- These options don't imply any `Wants=`, `Requires`=, `Requisite=`, or `BindsTo=` so any units listed in `Before=`/`After=` must appear in one of these, otherwise the unit will never start\n\t- `[Install]` section options\n\t\t- `WantedBy=`, `RequiredBy=`, `UpheldBy=`\n\t\t\t- A symbolic link is created in the `.wants/`, `.requires/`, or `.upholds/` directory of each of the listed units when this unit is installed by `systemctl enable`\n\t\t\t- This has the effect of a dependency of type `Wants=`, `Requires=`, or `Upholds=` being added from the listed unit to the current unit\n\t\t\t-\n- services\n\t- parameters\n\t\t- `Type=`\n\t\t\t- oneshot\n\t\t\t\t- Blocks on a start operation until the first process exits, and its state will be reported as \"activating\";\n\t\t\t\t- Once the first process exits, transitions from \"activating\" straight to \"inactive\", unless `RemainAfterExit=true` is set (in which case it becomes \"active\" with no processes!);\n\t\t\t\t- May have any number (0 or more) of `ExecStart=` directives which will be executed sequentially (waiting for each started process to exit before starting the next one);\n\t\t\t\t- May leave out `ExecStart=` but have `ExecStop=` (useful together with `RemainAfterExit=true` for arranging things to run on system shutdown).\n\t\t\t- simple\n\t\t\t\t- Does not block on a start operation (i. e. becomes \"active\" immediately after forking off the first process, even if it is still initializing!);\n\t\t\t\t- Once the first process exits, transitions from \"active\" to \"inactive\" (there is no `RemainAfterExit=` option);\n\t\t\t\t- Is generally discouraged because there is no way to distinguish situations like \"exited on start because of a configuration error\" from \"crashed after 500ms of runtime\" and suchlike.",536884361]],["^15",[1585,"^1:","~m1725099503509",536884360]],["^15",[1585,"^Z","pages/systemd.md",536881490]],["^15",[1585,"^1;",5288,536904132]],["^15",[1586,"^Q","system-wide",536881515]],["^15",[1586,"^O","^16",536881505]],["^15",[1586,"^@",false,536881505]],["^15",[1586,"^F",1584,536881505]],["^15",[1586,"^X",1582,536881505]],["^15",[1586,"^V",1584,536881507]],["^15",[1586,"^U",1582,536882360]],["^15",[1586,"^;","~u66ae3501-01a3-44c9-ae0a-4677dc4eca48",536881505]],["^15",[1587,"^Q","Always running (PID 1)",536881546]],["^15",[1587,"^O","^16",536881518]],["^15",[1587,"^@",false,536881518]],["^15",[1587,"^F",1586,536881518]],["^15",[1587,"^X",1582,536881518]],["^15",[1587,"^V",1586,536881522]],["^15",[1587,"^U",1582,536882360]],["^15",[1587,"^;","~u66ae350d-e00f-4dcc-b4d3-b777c76454a8",536881518]],["^15",[1588,"^Q","System-level services",536881562]],["^15",[1588,"^O","^16",536881547]],["^15",[1588,"^@",false,536881547]],["^15",[1588,"^F",1587,536881547]],["^15",[1588,"^X",1582,536881547]],["^15",[1588,"^V",1586,536881547]],["^15",[1588,"^U",1582,536882360]],["^15",[1588,"^;","~u66ae3529-7540-41f9-9fcd-9801e51b4249",536881547]],["^15",[1589,"^Q","per-user",536881578]],["^15",[1589,"^O","^16",536881563]],["^15",[1589,"^@",false,536881563]],["^15",[1589,"^F",1586,536881569]],["^15",[1589,"^X",1582,536881563]],["^15",[1589,"^V",1584,536881569]],["^15",[1589,"^U",1582,536882360]],["^15",[1589,"^;","~u66ae353b-48da-4f41-870a-131c44ecabb1",536881563]],["^15",[1590,"^Q","Started/stopped upon user logon/logoff",536881606]],["^15"