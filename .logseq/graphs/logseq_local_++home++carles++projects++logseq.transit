]],["^15",[423,"^Q","Rotate shoulder blades back and out",536873018]],["^15",[423,"^O","^16",536873018]],["^15",[423,"^F",323,536873018]],["^15",[423,"^X",312,536873018]],["^15",[423,"^V",332,536873018]],["^15",[423,"^U",312,536873018]],["^15",[423,"^;","~u665f4870-ea2b-4160-b030-5f110ddb0911",536873018]],["^15",[424,"^Q","[Reference Manual](https://nixos.org/manual/nix/unstable/)",536873031]],["^15",[424,"^O","^16",536873027]],["^15",[424,"^@",false,536873027]],["^15",[424,"^F",351,536873027]],["^15",[424,"^X",105,536873027]],["^15",[424,"^V",105,536873027]],["^15",[424,"^U",105,536873028]],["^15",[424,"^?",["^ "],536873031]],["^15",[424,"^;","~u665f6950-5b29-47ff-81f5-c1750bf6575f",536873027]],["^15",[425,"^Q","[Configuration options](https://rycee.gitlab.io/home-manager/options.html)",536873048]],["^15",[425,"^O","^16",536873043]],["^15",[425,"^@",false,536873043]],["^15",[425,"^F",453,536873234]],["^15",[425,"^X",57,536873043]],["^15",[425,"^V",57,536873043]],["^15",[425,"^U",57,536873044]],["^15",[425,"^;","~u665f6985-7057-4921-ae47-ee6e664d0104",536873043]],["^15",[426,"^3","tags:: Nix\n\n- [Configuration options](https://rycee.gitlab.io/home-manager/options.html)",536873234]],["^15",[426,"^1:","~m1717598530687",536873235]],["^15",[426,"^Z","pages/home-manager.md",536873049]],["^15",[426,"^1;",88,536904132]],["^15",[434,"^Q","",536873145]],["^15",[434,"^O","^16",536873145]],["^15",[434,"^@",false,536873145]],["^15",[434,"^?",["^ "],536873145]],["^15",[434,"^;","~u665f6bd1-fd80-4b5a-987b-eed60dc38d6b",536873145]],["^15",[435,"^12",2,536873211]],["^15",[438,"^3","tags:: sysadmin\n\n- Filesystems\n\t- BTRFS\n\t\t- [Scrub](https://btrfs.readthedocs.io/en/latest/Scrub.html)\n\t\t\t- A pass over all filesystem data and metadata and verifying the checksums\n\t\t\t- If a valid copy is available (replicated block group profiles) then the damaged one is repaired\n\t\t\t- Once a month\n\t\t\t- `doas btrfs scrub start /data/immich`\n\t- Bind mount\n\t  tags:: disk management\n\t\t- [What is a bind mount?](https://unix.stackexchange.com/a/198591)\n\t\t\t- Alternate view of a directory tree\n\t\t\t- *Mounting* creates a view of a storage device as a directory tree.\n\t\t\t- A *bind mount* instead takes an existing directory tree and mirrors it under a different point\n\t\t\t- Any modification on one side is immediately reflected on the other view\n\t\t\t- Unlike a hard link or symbolic link, a bind mount doesn't affect what is stored on the filesystem. It's a property of the live system.\n\t\t\t- Use cases\n\t\t\t\t- Read-only view\n\t\t\t\t- Remapping users and group IDs\n\t\t\t\t- chroot\n\t\t\t\t- As a substitute for symbolic links\n- Encryption\n\t- LUKS\n\t\t- Used to encrypt a block device\n\t\t- The contents of the encrypted device are arbitrary, and therefore any filesystem can be encrypted, including swap partitions\n\t\t- There is an unencrypted header at the beginning of an encrypted volume stored along with encryption parameters such as cipher type and key size\n\t\t- The defaults are quite good already and (I believe) are optimised for your system (`cryptsetup benchmark`)",536873374]],["^15",[438,"^19",1717607794838,536873216]],["^15",[438,"^1:","~m1717608931753",536873373]],["^15",[438,"^Z","pages/disk management.md",536873216]],["^15",[438,"^1;",1450,536904132]],["^15",[439,"^K",1717607794837,536873216]],["^15",[439,"^[",438,536873216]],["^15",[439,"^@",false,536873216]],["^15",[439,"^Y","disk management",536873216]],["^15",[439,"^11","disk management",536873216]],["^15",[439,"^?",["^ ","^17",["^18",["sysadmin"]]],536873216]],["^15",[439,"^4",["^ ","^17","sysadmin"],536873216]],["^15",[439,"^P",221,536873216]],["^15",[439,"^B",1717608931443,536873371]],["^15",[439,"^;","~u66609d73-62e8-4a7f-a1f9-2a6181e30820",536873244]],["^15",[440,"^Q","tags:: sysadmin\n",536873216]],["^15",[440,"^O","^16",536873216]],["^15",[440,"^1B",["^18",[]],536873216]],["^15",[440,"^F",439,536873216]],["^15",[440,"^X",439,536873216]],["^15",[440