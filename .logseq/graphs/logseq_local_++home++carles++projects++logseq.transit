5",[2582,"^Q","mission",536901365]],["^15",[2582,"^O","^16",536901352]],["^15",[2582,"^@",false,536901352]],["^15",[2582,"^F",2571,536901352]],["^15",[2582,"^X",2567,536901352]],["^15",[2582,"^V",2567,536901352]],["^15",[2582,"^U",2567,536901353]],["^15",[2582,"^;","~u6787a08f-6a2f-4ad3-986d-87e1b5e5035d",536901352]],["^15",[2583,"^Q","maintain monetary and financial stability for the good of the people of the United Kingdom",536901400]],["^15",[2583,"^O","^16",536901366]],["^15",[2583,"^@",false,536901366]],["^15",[2583,"^F",2582,536901366]],["^15",[2583,"^X",2567,536901366]],["^15",[2583,"^V",2582,536901368]],["^15",[2583,"^U",2567,536901367]],["^15",[2583,"^;","~u6787a099-0c14-40e1-a2c5-a04ccafaea2c",536901366]],["^15",[2585,"^Q","UK Government",536901432]],["^15",[2585,"^O","^16",536901414]],["^15",[2585,"^@",false,536901414]],["^15",[2585,"^F",2581,536901414]],["^15",[2585,"^X",2567,536901414]],["^15",[2585,"^V",2581,536901420]],["^15",[2585,"^U",2567,536901454]],["^15",[2585,"^;","~u6787a13f-4c01-4b55-9395-cda0e53ebd1e",536901414]],["^15",[2586,"^Q","other central banks",536901516]],["^15",[2586,"^O","^16",536901457]],["^15",[2586,"^@",false,536901457]],["^15",[2586,"^F",2585,536901457]],["^15",[2586,"^X",2567,536901457]],["^15",[2586,"^V",2581,536901457]],["^15",[2586,"^U",2567,536901458]],["^15",[2586,"^;","~u6787a153-635a-44b7-861b-be5ca8d774cb",536901457]],["^15",[2589,"^Q","[[central counterparties]] (CCPs)",536901529]],["^15",[2589,"^O","^16",536901516]],["^15",[2589,"^@",false,536901516]],["^15",[2589,"^F",2586,536901516]],["^15",[2589,"^X",2567,536901516]],["^15",[2589,"^V",2581,536901516]],["^15",[2589,"^U",2567,536901530]],["^15",[2589,"^U",2590,536901530]],["^15",[2589,"^H",2590,536906341]],["^15",[2589,"^;","~u6787a1d2-7899-4e03-b312-27557c90ef0e",536901516]],["^15",[2590,"^5",2596,536901641]],["^15",[2590,"^K",1736942436495,536901529]],["^15",[2590,"^[",2592,536901538]],["^15",[2590,"^O","^16",536901533]],["^15",[2590,"^@",false,536901529]],["^15",[2590,"^Y","central counterparties",536901529]],["^15",[2590,"^11","central counterparties",536901529]],["^15",[2590,"^?",["^ ","^1I",["^18",["CCPs"]]],536901641]],["^15",[2590,"^4",["^ ","^1I","CCPs"],536901641]],["^15",[2590,"^B",1736947509928,536902654]],["^15",[2590,"^;","~u67b71e8a-dc09-4fab-857d-3a43fa7f7306",536906341]],["^15",[2592,"^3","alias:: CCPs\n\n- [Central counterparties: what are they, why do they matter and how does the Bank supervise them?](../assets/central_counterparties.pdf)\n- They guarantee the obligations under the contract agreed between the two counterparties of a trade\n- They a key to prevent the knock-on effect of a default from one counterparty affecting the credit risk of the counterparty on the opposite site which is a potential source of systemic risk\n- In the past, CCPs were not required to trade over-the-counter (OTC) derivatives (investment banks fullfilled that function) but since the 2008 financial crisis there has been a push by G20 countries to standardize them using CPPs\n- Any position taken on with one counterparty is always offset by an opposite position taken on with a second counterparty, i.e. CCPs do not **directly** take on market risk\n- They are exposed to the risk that a counterparty defaults (credit risk) on outstanding contracts potentially leaving their book exposed to market risk\n- They manage the credit risk by\n\t- running credit, liquidity and operational reliability checks on the counterparties\n\t- taking collateral (margin) from both counterparties\n\t- multilateral netting, offsetting credit risk with opposite trades\n\t- All counterparties are required to contribute to a default fund to *mutualize* outstanding losses across all the other (non-defaulting) members\n\t- Lines of defence after counterparty default\n\t\t- collateral\n\t\t  logseq.order-list-type:: number\n\t\t- counterparty default fund contributions\n\t\t  logseq.order-list-type:: number\n\t\t- counterparty equity\n\t\t  logseq.order-list-type:: number\n\t\t- default fund\n\t\t  logseq.order-list-type:: number\n\t\t- ask surviving members to contribute a further amount (rights of assessment)\n\t\t  logseq.order-list-type:: number\n\t\t- CPP equity\n\t\t  logseq.order-list-type:: number",536902668]],["^15",[2592,"^1:","~m1736947526730",536902667]],["^15",[2592,"^Z","pages/central counterparties.md",536901538]],["^15",[2592,"^1;",1850,536904132]],["^15",[2593,"^Q","Any position taken on with one counterparty is always offset by an opposite position taken on with a second counterparty, i.e. CCPs do not **directly** take on market risk",536901700]],["^15",[2593,"^O","^16",536901580]],["^15",[2593,"^@",false,536901580]],["^15",[2593,"^F",2601,536901766]],["^15",[2593,"^X",2590,536901580]],["^15",[2593,"^V",2590,536901580]],["^15",[2593,"^U",2590,536901581]],["^15",[2593,"^?",["^ "],536901763]],["^15",[2593,"^;","~u6787a3d8-2995-4296-8e54-ef78538f67de",536901580]],["^15",[2595,"^Q","alias:: CCPs",536901641]],["^15",[2595,"^O","^16",536901634]],["^15",[2595,"^1B",["^18",[]],536901641]],["^15",[2595,"^@",false,536901634]],["^15",[2595,"^F",2590,536901634]],["^15",[2595,"^X",2590,536901634]],["^15",[2595,"^V",2590,536901634]],["^15",[2595,"^U",2590,536901642]],["^15",[2595,"^U",2596,536901642]],["^15",[2595,"^:",true,536901641]],["^15",[2595,"^?",["^ ","^1I",["^18",["CCPs"]]],536901641]],["^15",[2595,"^J",["^14",["^1I"]],536901641]],["^15",[2595,"^4",["^ ","^1I","CCPs"],536901641]],["^15",[2595,"^H",2596,536901641]],["^15",[2595,"^;","~u6787a41a-8e49-4fcd-822d-aa057e2b5430",536901634]],["^15",[2596,"^K",1736942627039,536901641]],["^15",[2596,"^@",false,536901641]],["^15",[2596,"^Y","ccps",536901641]],["^15",[2596,"^11","CCPs",536901641]],["^15",[2596,"^B",1736942627039,536901641]],["^15",[2597,"^Q","They are exposed to the risk that a counterparty defaults (credit risk) on outstanding contracts potentially leaving their book exposed to market risk",536901713]],["^15",[2597,"^O","^16",536901645]],["^15",[259