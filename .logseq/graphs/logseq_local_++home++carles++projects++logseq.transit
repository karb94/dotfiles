-ef5b7c6d9edc",536871539]],["^15",[236,"^Q","Resources",536871560]],["^15",[236,"^O","^16",536871552]],["^15",[236,"^F",419,536873003]],["^15",[236,"^X",219,536871552]],["^15",[236,"^V",219,536871556]],["^15",[236,"^U",219,536871553]],["^15",[236,"^;","~u6658d759-bc56-4509-b347-a44b6296e46f",536871552]],["^15",[237,"^Q","[Different ways to structure data](https://discuss.logseq.com/t/different-ways-to-structure-data/8819/4)",536872088]],["^15",[237,"^O","^16",536871564]],["^15",[237,"^F",268,536872107]],["^15",[237,"^X",219,536871564]],["^15",[237,"^V",268,536872141]],["^15",[237,"^U",219,536872183]],["^15",[237,"^;","~u6658d76e-ef8c-4dba-8f28-1898c28b060f",536871564]],["^15",[266,"^Q","[The Most Legit Use of Namespaces](https://discuss.logseq.com/t/the-most-legit-use-of-namespaces/17685)",536872081]],["^15",[266,"^O","^16",536872071]],["^15",[266,"^F",237,536872104]],["^15",[266,"^X",219,536872071]],["^15",[266,"^V",268,536872141]],["^15",[266,"^U",219,536872183]],["^15",[266,"^;","~u6658ec6e-fd92-4ef2-9016-c6d265007922",536872071]],["^15",[267,"^Q","You can achieve better results with",536872186]],["^15",[267,"^O","^16",536872091]],["^15",[267,"^F",237,536872091]],["^15",[267,"^X",219,536872091]],["^15",[267,"^V",237,536872091]],["^15",[267,"^U",219,536872183]],["^15",[267,"^;","~u6658ec85-b67e-4f30-843e-dd64468068d2",536872091]],["^15",[268,"^Q","Logseq forums",536872138]],["^15",[268,"^O","^16",536872107]],["^15",[268,"^F",220,536872107]],["^15",[268,"^X",219,536872107]],["^15",[268,"^V",220,536872107]],["^15",[268,"^U",219,536872183]],["^15",[268,"^;","~u6658ecba-ec9c-41d8-9a49-243234797077",536872107]],["^15",[272,"^Q","indenting hierarchies",536872186]],["^15",[272,"^O","^16",536872186]],["^15",[272,"^F",267,536872186]],["^15",[272,"^X",219,536872186]],["^15",[272,"^V",267,536872190]],["^15",[272,"^U",219,536872187]],["^15",[272,"^;","~u6658eda0-1861-4b63-af02-545600caf85b",536872186]],["^15",[273,"^Q","Wikipedia method: `[[Apple (Company)]]`, `[[Apple (Fruit)]]`",536872230]],["^15",[273,"^O","^16",536872193]],["^15",[273,"^F",272,536872193]],["^15",[273,"^X",219,536872193]],["^15",[273,"^V",267,536872193]],["^15",[273,"^U",219,536872194]],["^15",[273,"^;","~u6658eda2-e17c-4220-b595-6c01261d4c0e",536872193]],["^15",[276,"^12",2,536872237]],["^15",[279,"^12",2,536872242]],["^15",[280,"^12",2,536872245]],["^15",[311,"^3","- Posture\n\t- Breath in and keep the height as you breath out\n\t\t- Feel your abs surround your stomach\n\t\t- Keep your lower back as far back as you can\n\t\t- Do not fully stretch your legs\n\t- Rotate shoulder blades back and out\n\t- Relax the front side of the shoulders as you raise the sternum\n\t\t- You should feel a stretch in the pecs as you do this\n\t\t- Raise the sternum really towards your head. This will realign your hips as well.\n\t\t- Pull the sternum back until it connects with your feet and the floor\n\t- Rotate your hips inwards from the legs not from the lower back\n\t- Keep the hips back and connected with the lower back\n\t- Legs must be always _available_\n- Lead\n\t- Lead with the sternum\n\t\t- Two types of lead\n\t\t\t- Up: raise sternum\n\t\t\t- Down: bring the sternum towards you\n\t- Ochos\n\t\t- Don't move your shoulders\n\t\t- Let the sternum move and rotate within the frame of your embrace\n\t\t- Lead her ocho from the middle of your step\n\t\t\t- Don't transfer your weight until the follower has almost finished her pivot\n\t- Close-to-open embrace\n\t\t- From the basic step let the follower fully arrive to the backleg and then bring your body back\n\t\t- From the ocho step diagonally back\n\t- Giros\n\t\t- With sacadas\n\t\t\t- Lead the steps only with the sternum without moving\n\t\t\t- only move when there is a clear direction for the follower\n\t\t\t- How do you make the follower do long steps?\n\t\t\t\t- You generally can't. Get gud!😉\n\t- Rythmic music\n\t\t- don't lift your hip when doing side steps, let them go\n-",536880045]],["^15",[311,"^19",1717234360866,536872254]],["^15",[311,"^1:","~m1719357605107",536880046]],["^15",[311,"^Z","pages/Tango.md",536872254]],["^15",[312,"^K",1717234360866,536872254]],["^15",[312,"^[",311,536872254]],["^15",[312,"^@",false,536872254]],["^15",[312,"^Y","tango",536872254]],["^15",[312,"^11","Tango",536872254]],["^15",[312,"^B",1717234360866,536872254]],["^15",[312,"^;","~u66a60c9c-d2a5-4f5d-9ced-356b84ac7053",536880121]],["^15",[313,"^Q","Relax the front side of the shoulders as you raise the sternum",536872254]],["^15",[313,"^O","^16",536872254]],["^15",[313,"^F",423,536873018]],["^15",[313,"^X",312,536872254]],["^15",[313,"^V",332,536872254]],["^15",[313,"^U",312,536872254]],["^15",[313,"^;","~u665aeab8-d7c2-492b-bee2-c07b42b5140b",536872254]],["^15",[314,"^Q","Keep your lower back as far back as you can",536872254]],["^15",[314,"^O","^16",536872254]],["^15",[314,"^F",334,536872254]],["^15",[314,"^X",312,536872254]],["^15",[314,"^V",323,536872254]],["^15",[314,"^U",312,536872254]],["^15",[314,"^;","~u665aeab8-0af3-4169-a518-b191105f5a7b",536872254]],["^15",[315,"^Q","Up: raise sternum",536872254]],["^15",[315,"^O","^16",536872254]],["^15",[315,"^F",336,536872254]],["^15",[315,"^X",312,536872254]],["^15",[315,"^V",336,536872254]],["^15",[315,"^U",312,536872254]],["^15",[315,"^;","~u665aeab8-a280-4ed5-9a18-ba4f1e58a726",536872254]],["^15",[316,"^Q","Giros",536872254]],["^15",[316,"^O","^16",536872254]],["^15",[316,"^F",330,536872254]],["^15",[316,"^X",312,536872254]],["^15",[316,"^V",328,536872254]],["^15",[316,"^U",312,536872254]],["^15",[316,"^;","~u665aeab8-0874-4392-966c-14fbfd365ba5",536872254]],["^15",[317,"^Q","From the basic step let the follower fully arrive to the backleg and then bring your body back",536872254]],["^15",[317,"^O","^16",536872254]],["^15",[317,"^F",330,536872254]],["^15",[317,"^X",312,536872254]],["^15",[317,"^V",330,536872254]],["^15",[317,"^U",312,536872254]],["^15",[317,"^;","~u665aeab8-84fa-46da-83a0-de9e0a0b2342",536872254]],["^15",[318,"^Q","Lead the step