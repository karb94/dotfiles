00320]],["^15",[2539,"^V",2538,536900322]],["^15",[2539,"^U",2465,536904352]],["^15",[2539,"^U",2696,536904352]],["^15",[2539,"^?",["^ "],536900383]],["^15",[2539,"^;","~u677aeb20-eae9-4e20-8cd5-3bb846983c03",536900320]],["^15",[2540,"^Q","or equivalently  $\\frac{dS}{S} = \\mu \\, dt + \\sigma \\, dz$",536900416]],["^15",[2540,"^O","^16",536900361]],["^15",[2540,"^@",false,536900361]],["^15",[2540,"^F",2539,536900361]],["^15",[2540,"^X",2465,536900361]],["^15",[2540,"^V",2538,536900361]],["^15",[2540,"^U",2465,536904352]],["^15",[2540,"^U",2696,536904352]],["^15",[2540,"^?",["^ "],536900416]],["^15",[2540,"^;","~u677aeb44-0abf-4de4-8bbf-18e151c66649",536900361]],["^15",[2542,"^Q","tags:: finance",536900431]],["^15",[2542,"^O","^16",536900427]],["^15",[2542,"^1B",["^18",[]],536900431]],["^15",[2542,"^@",false,536900427]],["^15",[2542,"^F",2465,536900427]],["^15",[2542,"^X",2465,536900427]],["^15",[2542,"^V",2465,536900427]],["^15",[2542,"^U",1101,536900432]],["^15",[2542,"^U",2465,536900432]],["^15",[2542,"^:",true,536900431]],["^15",[2542,"^?",["^ ","^17",["^18",["finance"]]],536900431]],["^15",[2542,"^J",["^14",["^17"]],536900431]],["^15",[2542,"^4",["^ ","^17","finance"],536900431]],["^15",[2542,"^H",1101,536900431]],["^15",[2542,"^;","~u677aedcd-401f-46a4-935d-7cda3893f4d7",536900427]],["^15",[2548,"^Q","pricing",536900484]],["^15",[2548,"^O","^16",536900476]],["^15",[2548,"^F",589,536900481]],["^15",[2548,"^X",537,536900476]],["^15",[2548,"^V",537,536900481]],["^15",[2548,"^U",537,536900477]],["^15",[2548,"^?",["^ "],536900484]],["^15",[2548,"^;","~u677af2ac-cca8-418d-bc1d-0b5bd42f4021",536900476]],["^15",[2549,"^Q","Using the ((678d3bcc-03b2-4fbd-a783-857ab95d7f01))",536904321]],["^15",[2549,"^O","^16",536900498]],["^15",[2549,"^@",false,536900498]],["^15",[2549,"^F",2550,536900567]],["^15",[2549,"^X",537,536900498]],["^15",[2549,"^V",2548,536900570]],["^15",[2549,"^U",537,536904322]],["^15",[2549,"^U",2728,536904322]],["^15",[2549,"^?",["^ "],536904321]],["^15",[2549,"^H",2728,536904321]],["^15",[2549,"^;","~u677af2e5-78c1-4dd7-9a7c-6f46fb9d1e1f",536900498]],["^15",[2550,"^Q","The price of any derivative is a function of the stochastic variables underlying the derivative and time",536900552]],["^15",[2550,"^O","^16",536900518]],["^15",[2550,"^@",false,536900518]],["^15",[2550,"^F",2548,536900563]],["^15",[2550,"^X",537,536900518]],["^15",[2550,"^V",2548,536900559]],["^15",[2550,"^U",537,536900519]],["^15",[2550,"^?",["^ "],536900552]],["^15",[2550,"^;","~u677af4e1-bb90-45c6-b408-738afa2797dd",536900518]],["^15",[2566,"^12",2,536901110]],["^15",[2567,"^K",1736940042075,536901112]],["^15",[2567,"^[",2569,536901118]],["^15",[2567,"^O","^16",536901112]],["^15",[2567,"^@",false,536901112]],["^15",[2567,"^Y","bank of england",536901112]],["^15",[2567,"^11","Bank of England",536901112]],["^15",[2567,"^?",["^ ","^17",["^18",["finance"]]],536901116]],["^15",[2567,"^4",["^ ","^17","finance"],536901116]],["^15",[2567,"^P",1101,536906341]],["^15",[2567,"^B",1736972150126,536903895]],["^15",[2567,"^;","~u67b71e8a-ef96-48ca-a3c8-46e1516fa690",536906341]],["^15",[2568,"^Q","tags:: finance\n\n",536906341]],["^15",[2568,"^O","^16",536901113]],["^15",[2568,"^1B",["^18",[]],536906341]],["^15",[2568,"^@",false,536901113]],["^15",[2568,"^F",2567,536901113]],["^15",[2568,"^X",2567,536901113]],["^15",[2568,"^V",2567,536901113]],["^15",[2568,"^U",1101,536901117]],["^15",[2568,"^U",2567,536901117]],["^15",[2568,"^:",true,536906341]],["^15",[2568,"^?",["^ ","^17",["^18",["finance"]]],536906341]],["^15",[2568,"^J",["^17"],536906341]],["^15",[2568,"^4",["^ ","^17","finance"],536906341]],["^15",[2568,"^H",1101,536906341]],["^15",[2568,"^;","~u67879a0a-ba9d-44ab-840c-5e6d451eaf3d",536901113]],["^15",[2569,"^3","tags:: finance\n\n- United Kingdom central bank\n- Owned by the UK government but independent from it\n- mission\n\t- maintain monetary and financial stability for the good of the people of the United Kingdom\n- responsibilities\n\t- Issuing banknotes\n\t- Processing electronic payments and supervise payment services (e.g. VISA)\n\t- Hold gold reserves belonging to the UK and other central banks\n\t- Maintain a stable financial system\n\t\t- Provide banking services for\n\t\t\t- UK Government\n\t\t\t- other central banks\n\t\t\t- [[central counterparties]] (CCPs)\n\t\t- Main services provided\n\t\t\t- sterling accounts and payment services\n\t\t\t- fixed-term deposits\n\t\t\t- gold custody services\n\t\t\t- securities settlement and custody\n\t\t\t- foreign currency commercial paper\n\t- Keeping inflation at the target set by the UK Government (2%)\n\t\t- The Monetary Policy Committe sets the monetary policy to achieve the governments target inflation\n\t\t- The BoE has two tools to influence inflation\n\t\t\t- bank rate\n\t\t\t  id:: 6787bc25-13f8-4614-9154-8a941798be60\n\t\t\t\t- Interest rate paid to deposits placed overnight by eligible firms such as commercial banks\n\t\t\t\t\t- The bank rate is a proxy for the interest rate commercial banks provide for savings accounts and require for loans\n\t\t\t- quantitative easing (QE)\n\t\t\t\t- Buy bonds (mostly government bonds but also corporate bonds) using reserves to push up their prices and bring down longer-term interest rates on savings and loans\n\t\t\t\t- It is generally used when the bank rate is already very low and there is limited scope to lower it further\n\t\t\t\t- The BoE started using QE in March 2009 in response to the Global Financial Crisis when the Bank Rate was already very low (0.5%)\n\t\t\t\t- From February 2022 the BoE started the reverse process ('quantitative tightening') to reduce their stock of bonds\n\t\t\t\t\t- They do it in a way that (in theory) doesn't affect the economy in any way\n\t\t\t\t\t- Important read: [UK Parliament: Quantitative Tightening report](https://publications.parliament.uk/pa/cm5804/cmselect/cmtreasy/219/report.html)\n\t\t\t\t\t- Other Central banks like the Fed and ECB have plans to do this\n\t\t\t\t- QE is thought to stimulate economic activity and inflation by\n\t\t\t\t\t- portfolio rebalancing\n\t\t\t\t\t\t- Less gilts in circulation increases their price and reduces their yield becoming a less attractive asset for investors\n\t\t\t\t\t\t- Investors invest in other assets (hopefully productive ones)\n\t\t\t\t\t- market liquidity\n\t\t\t\t\t\t- By adding a major buyer to the market, QE improves liquidity which reduces the yield of the gilts\n\t\t\t\t\t- signalling\n\t\t\t\t\t\t- Signals the market that the Bank intends to maintain low interest rates for an extended period of time\n\t\t\t\t\t\t- If investors have confidence that BoE will do whatever is necessary to control inflation they can be content with a lower gilt yield\n\t\t\t\t\t-\n- balance sheet\n\t- liabilities\n\t\t- central bank reserves\n\t\t\t- Deposits that commercial banks and the HM Tresury hold at the central bank\n\t\t\t- Serve as the ultimate means of settlement for transactions in the economy\n\t\t\t- Earn interest at the ((6787bc25-13f8-4614-9154-8a941798be60))\n\t\t- bank notes\n\t\t\t- small relative to reserves\n\t- What is the optimal level of reserves?\n\t\t- ample reserves\n\t\t\t- pros\n\t\t\t\t- Better financial stability\n\t\t\t\t- Banks don't need to manage their day-to-day liquidity\n\t\t\t- cons\n\t\t\t\t- banking system behaviours may change in undesirable ways over time the longer the central bank balance sheet remains large\n\t\t\t\t- Banks are not prepared to manage their liquidity appropiately during a financial crisis\n\t\t\t\t- The Bank takes too much interest rate risk from it's bonds portfolio\n\t\t- scarce reserves\n\t\t\t- pros\n\t\t\t\t- Banks are used to managing their own liquidity\n\t\t\t\t- More headroom for further QE in the future\n\t\t\t- cons\n\t\t\t\t- If too low, banks may seek to borrow reserves in money markets, bidding up the price in the process and thereby causing short-term interest rates to rise relative to Bank Rate which negates its use as a monetary policy tool\n\t\t- middle ground, aka Preferred Minimum Range of Reserves (PMRR)\n\t\t\t- Cannot be objectively observed\n\t\t\t- Likely to evolve over time\n\t\t\t- Affected by\n\t\t\t\t- how the Bank supplies reserves\n\t\t\t\t- asset composition of banks\n\t\t\t\t- liquidity regulations\n\t\t\t- ![Preferred Minimum Range of Reserves](../assets/pmrr.png)\n\t\t\t-\n\t\t\t-\n\t- history\n\t\t- Government debt and central bank reserves held by banks as a ratio of deposits\n\t\t\t- ![Government debt over time](../assets/government_debt_chart.png)\n\t\t- The composition of bank assets started changing in the 1950s and 1960s\n\t\t\t- During the 1970s and 1980s, financial liberalisation and the removal of controls on the banks and building societies led to a significant decline in the public sector liquid assets ratio\n\t\t\t- By the early 2000s only the bare minimum of reserves required for day-to-day settlement were held and very few public sector liquid assets, which could be used as collateral to obtain more reserves from the Bank when required\n\t\t\t- As the global financial crisis unfolded later in the decade, wholesale funding markets dried up and it became increasingly difficult for banks to sell securities backed by mortgages or other assets, or to use them as collateral to borrow cash\n\t\t\t- ((66670527-36b8-48cb-a890-6c1eb573c785))s were now left with an ‘overhang’ of illiquid assets on their balance sheets\n\t\t\t- The Bank had to widen the collateral it was prepared to accept in its money market operations, and it introduced schemes to allow banks to swap what had become illiquid private securities for UK Treasury bills\n\t\t\t- ![The composition of bank assets changed in the 1950s and 1960s](../assets/BoE_asset_composition.png)\n\t\t\t-\n\t\t- ((667489d8-57ac-433e-aa3d-298f43c25c71)) has been the main driver of central ((6665782c-8bea-467c-8657-7183e047c130)) creation after the financial crisis of 2008\n\t\t\t- Further reserves were added via Term funding schemes (loans) for small and medium-sized enterprises\n\t\t\t- While its main purpose was to stimulate the economy it also served the secondary purpose of re-building the level of reserves and safe public sector liquid assets from what had proven to be an inadequate level during the global financial crisis\n\t\t\t- ![Quantitative Easing](../assets/quantitative_easing.png)\n\t\t- In 2022 asset purchases started unwinding through Quantitative Tightening\n\t\t-\n\t-\n- resources\n\t- [The importance of central bank reserves - lecture by Andrew Bailey](../assets/the_importance_of_central_bank_reserves-Andrew_Bailey.pdf)",536906341]],["^15",[2569,"^1:","~m1738366388540",536906342]],["^15",[2569,"^Z","pages/Bank of England.md",536901118]],["^15",[2569,"^1;",2801,536904132]],["^15",[2570,"^Q","United Kingdom central bank",536901140]],["^15",[2570,"^O","^16",536901121]],["^15",[2570,"^@",false,536901121]],["^15",[2570,"^F",2568,536901121]],["^15",[2570,"^X",2567,536901121]],["^15",[2570,"^V",2567,536901121]],["^15",[2570,"^U",2567,536901122]],["^15",[2570,"^;","~u67879a10-f23e-4acd-8480-15333a632aed",536901121]],["^15",[2571,"^Q","Owned by the UK government but independent from it",536901163]],["^15",[2571,"^O","^16",536901140]],["^15",[2571,"^@",false,536901140]],["^15",[2571,"^F",2570,536901140]],["^15",[2571,"^X",2567,536901140]],["^15",[2571,"^V",2567,536901140]],["^15",[2571,"^U",2567,536901141]],["^15",[2571,"^;","~u67879a6b-ef38-4509-8019-e0ec05a39b54",536901140]],["^15",[2572,"^Q","responsibilities",536901179]],["^15",[2572,"^O","^16",536901150]],["^15",[2572,"^@",false,536901150]],["^15",[2572,"^F",2582,536901368]],["^15",[2572,"^X",2567,536901150]],["^15",[2572,"^V",2567,536901150]],["^15",[2572,"^U",2567,536901151]],["^15",[2572,"^;","~u67879aa4-b2f9-4268-813e-da981df235a5",536901150]],["^15",[2574,"^Q","Issuing banknotes",536901193]],["^15",[2574,"^O","^16",536901186]],["^15",[2574,"^@",false,536901186]],["^15",[2574,"^F",2572,536901268]],["^15",[2574,"^X",