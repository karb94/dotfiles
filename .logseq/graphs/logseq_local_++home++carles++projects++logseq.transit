^15",[266,"^U",219,536872183]],["^15",[266,"^;","~u6658ec6e-fd92-4ef2-9016-c6d265007922",536872071]],["^15",[267,"^Q","You can achieve better results with",536872186]],["^15",[267,"^O","^16",536872091]],["^15",[267,"^F",237,536872091]],["^15",[267,"^X",219,536872091]],["^15",[267,"^V",237,536872091]],["^15",[267,"^U",219,536872183]],["^15",[267,"^;","~u6658ec85-b67e-4f30-843e-dd64468068d2",536872091]],["^15",[268,"^Q","Logseq forums",536872138]],["^15",[268,"^O","^16",536872107]],["^15",[268,"^F",220,536872107]],["^15",[268,"^X",219,536872107]],["^15",[268,"^V",220,536872107]],["^15",[268,"^U",219,536872183]],["^15",[268,"^;","~u6658ecba-ec9c-41d8-9a49-243234797077",536872107]],["^15",[272,"^Q","indenting hierarchies",536872186]],["^15",[272,"^O","^16",536872186]],["^15",[272,"^F",267,536872186]],["^15",[272,"^X",219,536872186]],["^15",[272,"^V",267,536872190]],["^15",[272,"^U",219,536872187]],["^15",[272,"^;","~u6658eda0-1861-4b63-af02-545600caf85b",536872186]],["^15",[273,"^Q","Wikipedia method: `[[Apple (Company)]]`, `[[Apple (Fruit)]]`",536872230]],["^15",[273,"^O","^16",536872193]],["^15",[273,"^F",272,536872193]],["^15",[273,"^X",219,536872193]],["^15",[273,"^V",267,536872193]],["^15",[273,"^U",219,536872194]],["^15",[273,"^;","~u6658eda2-e17c-4220-b595-6c01261d4c0e",536872193]],["^15",[276,"^12",2,536872237]],["^15",[279,"^12",2,536872242]],["^15",[280,"^12",2,536872245]],["^15",[311,"^3","- Posture\n\t- Breath in and keep the height as you breath out\n\t\t- Feel your abs surround your stomach\n\t\t- Keep your lower back as far back as you can\n\t\t- Do not fully stretch your legs\n\t- Rotate shoulder blades back and out\n\t- Relax the front side of the shoulders as you raise the sternum\n\t\t- You should feel a stretch in the pecs as you do this\n\t\t- Raise the sternum really towards your head. This will realign your hips as well.\n\t\t- Pull the sternum back until it connects with your feet and the floor\n\t- Activate your abs but not fully contract to remain flexible\n\t- Legs must be always _available_\n\t- WIP\n\t\t- Stay tall\n\t\t- Do not look down\n\t\t- Shouders back\n\t\t- Lower both arms so that the follower doesn't pull you down\n\t\t- Do your own crosses with feet together\n\t\t- medio giro with activated core\n- Lead\n\t- Lead with the sternum\n\t\t- Two types of lead\n\t\t\t- Up: raise sternum\n\t\t\t- Down: bring the sternum towards you\n\t- Ochos\n\t\t- Don't move your shoulders\n\t\t- Let the sternum move and rotate within the frame of your embrace\n\t\t- Lead her ocho from the middle of your step\n\t\t\t- Don't transfer your weight until the follower has almost finished her pivot\n\t- Close-to-open embrace\n\t\t- From the basic step let the follower fully arrive to the backleg and then bring your body back\n\t\t- From the ocho step diagonally back\n\t- Giros\n\t\t- With sacadas\n\t\t\t- Lead the steps only with the sternum without moving\n\t\t\t- only move when there is a clear direction for the follower\n\t\t\t- How do you make the follower do long steps?\n\t\t\t\t- You generally can't. Get gud!😉\n\t- Rythmic music\n\t\t- don't lift your hip when doing side steps, let them go\n- moves\n\t- double barrida (Geraldine y Ezequiel)\n\t- clock-wise medio giro ending with a forward ocho to the left and pica to accentuate next forward ocho (Dante Culcuy)\n- fix\n\t- voleo\n\t- side pressure\n\t- timing",536897855]],["^15",[311,"^19",1717234360866,536872254]],["^15",[311,"^1:","~m1729633255931",536897856]],["^15",[311,"^Z","pages/Tango.md",536872254]],["^15",[311,"^1;",1842,536904132]],["^15",[312,"^K",1717234360866,536872254]],["^15",[312,"^[",311,536872254]],["^15",[312,"^@",false,536872254]],["^15",[312,"^Y","tango",536872254]],["^15",[312,"^11","Tango",536872254]],["^15",[312,"^B",1726782299789,536894733]],["^15",[312,"^;","~u67797564-2721-4f46-9ce5-be4d715d57b1",536897855]],["^15",[313,"^Q","Relax the front side of the shoulders as you raise the sternum",536872254]],["^15",[313,"^O","^16",536872254]],["^15",[313,"^F",423,536873018]],["^15",[313,"^X",312,536872254]],["^15",[313,"^V",332,536872254]],["^15",[313,"^U",312,536872254]],["^15",[313,"^;","~u665aeab8-d7c2-492b-bee2-c07b42b5140b",536872254]],["^15",[314,"^Q","Keep your lower back as far back as you can",536872254]],["^15",[314,"^O","^16",536872254]],["^15",[314,"^F",334,536872254]],["^15",[314,"^X",312,536872254]],["^15",[314,"^V",323,536872254]],["^15",[314,"^U",312,536872254]],["^15",[314,"^;","~u665aeab8-0af3-4169-a518-b191105f5a7b",536872254]],["^15",[315,"^Q","Up: raise sternum",536872254]],["^15",[315,"^O","^16",536872254]],["^15",[315,"^F",336,536872254]],["^15",[315,"^X",312,536872254]],["^15",[315,"^V",336,536872254]],["^15",[315,"^U",312,536872254]],["^15",[315,"^;","~u665aeab8-a280-4ed5-9a18-ba4f1e58a726",536872254]],["^15",[316,"^Q","Giros",536872254]],["^15",[316,"^O","^16",536872254]],["^15",[316,"^F",330,536872254]],["^15",[316,"^X",312,536872254]],["^15",[316,"^V",328,536872254]],["^15",[316,"^U",312,536872254]],["^15",[316,"^;","~u665aeab8-0874-4392-966c-14fbfd365ba5",536872254]],["^15",[317,"^Q","From the basic step let the follower fully arrive to the backleg and then bring your body back",536872254]],["^15",[317,"^O","^16",536872254]],["^15",[317,"^F",330,536872254]],["^15",[317,"^X",312,536872254]],["^15",[317,"^V",330,536872254]],["^15",[317,"^U",312,536872254]],["^15",[317,"^;","~u665aeab8-84fa-46da-83a0-de9e0a0b2342",536872254]],["^15",[318,"^Q","Lead the steps only with the sternum without moving",536872254]],["^15",[318,"^O","^16",536872254]],["^15",[318,"^F",322,536872254]],["^15",[318,"^X",312,536872254]],["^15",[318,"^V",322,536872254]],["^15",[318,"^U",312,536872254]],["^15",[318,"^;","~u665aeab8-2922-4ba5-9002-464dc450d0ea",536872254]],["^15",[319,"^Q","Activate your abs but not fully contract to remain flexible",536894684]],["^15",[319,"^O","^16",536872254]],["^15",[319,"^F",313,536872254]],["^15",[319,"^X",312,536872254]],["^15",[319,"^V",332,536872254]],["^15",[319,"^U",312