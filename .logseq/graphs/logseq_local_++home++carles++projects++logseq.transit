5",[71,"^U",53,536873319]],["^15",[71,"^;","~u661a3633-8f97-43de-b7f2-ebd1ad814847",536870919]],["^15",[77,"^K",1712993843460,536870919]],["^15",[77,"^[",174,536871199]],["^15",[77,"^O","^16",536871194]],["^15",[77,"^@",false,536870919]],["^15",[77,"^Y","neovim",536870919]],["^15",[77,"^11","Neovim",536870919]],["^15",[77,"^?",["^ ","^17",["^18",["software"]]],536871205]],["^15",[77,"^4",["^ ","^17","software"],536871205]],["^15",[77,"^P",175,536880085]],["^15",[77,"^B",1720273895887,536880078]],["^15",[77,"^;","~u668ee98c-6983-4e0c-a30e-7fd78f750531",536880085]],["^15",[78,"^K",1712993843460,536870919]],["^15",[78,"^[",181,536871246]],["^15",[78,"^O","^16",536871241]],["^15",[78,"^@",false,536870919]],["^15",[78,"^Y","immich",536870919]],["^15",[78,"^11","Immich",536870919]],["^15",[78,"^?",["^ ","^17",["^18",["software"]]],536871252]],["^15",[78,"^4",["^ ","^17","software"],536871252]],["^15",[78,"^P",175,536871252]],["^15",[78,"^B",1717093740260,536871252]],["^15",[78,"^;","~u665f4870-9dfd-44bf-a5b5-15adf8859a5f",536872994]],["^15",[93,"^3","tags:: sysadmin\n\n- Linux most well established and feature rich network manager\n- You can change the wifi backend from wpa_supplicant to iwd\n- You can manage networks using:\n\t- nmcli\n\t\t- [Official Documentation](https://developer-old.gnome.org/NetworkManager/stable/nmcli.html)\n\t\t- [Official examples](https://developer-old.gnome.org/NetworkManager/stable/nmcli-examples.html)\n\t\t\t- Connect to wifi (with sudo priviledges)\n\t\t\t\t- `nmcli device wifi connect [--ask] \"$SSID\" password \"$PASSWORD\"`\n\t\t\t\t\t- `nmcli d w c [--ask] \"$SSID\"`\n\t\t\t\t- `nmcli connection up [--ask] \"$SSID\" password \"$PASSWORD\"`\n\t\t\t\t\t- `nmcli c u [--ask] \"$SSID\"`\n\t- nmtui\n\t- nm-connection-editor\n- When using `iwd` as the wifi backend the wifi settings are stored in `/var/lib/iwd`\n  id:: 6658623f-4291-4c5c-b7a4-65aa21ecae3a",536873247]],["^15",[93,"^19",1712993843466,536870919]],["^15",[93,"^1:","~m1717614835277",536873552]],["^15",[93,"^Z","pages/NetworkManager.md",536870919]],["^15",[94,"^K",1712993843466,536870919]],["^15",[94,"^[",93,536870919]],["^15",[94,"^@",false,536870919]],["^15",[94,"^Y","networkmanager",536870919]],["^15",[94,"^11","NetworkManager",536870919]],["^15",[94,"^?",["^ ","^17",["^18",["sysadmin"]]],536873012]],["^15",[94,"^4",["^ ","^17","sysadmin"],536873012]],["^15",[94,"^P",221,536873247]],["^15",[94,"^B",1712993843466,536870919]],["^15",[94,"^;","~u66609d73-4489-44a5-8ea6-656af5194404",536873247]],["^15",[99,"^Q","You can manage networks using:",536870919]],["^15",[99,"^O","^16",536870919]],["^15",[99,"^F",467,536873247]],["^15",[99,"^X",94,536870919]],["^15",[99,"^V",94,536870919]],["^15",[99,"^U",94,536870919]],["^15",[99,"^;","~u661a3633-b937-4809-a699-4fe98dfbc14a",536870919]],["^15",[100,"^Q","nmcli",536873247]],["^15",[100,"^O","^16",536870919]],["^15",[100,"^F",99,536870919]],["^15",[100,"^X",94,536870919]],["^15",[100,"^V",99,536870919]],["^15",[100,"^U",94,536870919]],["^15",[100,"^;","~u661a3633-44e0-4113-b5c5-9570f001daab",536870919]],["^15",[101,"^Q","nmtui",536870919]],["^15",[101,"^O","^16",536870919]],["^15",[101,"^F",100,536870919]],["^15",[101,"^X",94,536870919]],["^15",[101,"^V",99,536870919]],["^15",[101,"^U",94,536870919]],["^15",[101,"^;","~u661a3633-916b-4e7f-97f0-9f945be18727",536870919]],["^15",[102,"^Q","nm-connection-editor",536870919]],["^15",[102,"^O","^16",536870919]],["^15",[102,"^F",101,536870919]],["^15",[102,"^X",94,536870919]],["^15",[102,"^V",99,536870919]],["^15",[102,"^U",94,536870919]],["^15",[102,"^;","~u661a3633-8a67-4c43-b035-c4ae64816163",536870919]],["^15",[104,"^3","tags:: Nix\n\n- Documentation:\n\t- [NixOS manual](https://nixos.org/manual/nixos/unstable/)\n\t- [Nix manual](https://nixos.org/manual/nix/stable/)\n\t- [Nixpkgs manual](https://nixos.org/manual/nixpkgs/unstable/)\n\t- [NixOS & Flakes Book](https://nixos-and-flakes.thiscute.world/)\n\t-\n- You can set up [[Impermanence]] in your system\n- How to write derivations from shell scripts\n\t- https://ertt.ca/nix/shell-scripts/\n\t- You can create a desktop entry using `pkgs.makeDesktopItem`\n- [How to write conditional config](https://discourse.nixos.org/t/using-mkif-with-nested-if/5221/4)\n- [[container]]\n\t- Docker\n\t\t- exposes the necessary ports automatically\n\t\t\t- [NixOS/nixpkgs issue](https://github.com/NixOS/nixpkgs/issues/111852)\n\t\t\t- [NixOS wiki: Firewall](https://nixos.wiki/wiki/Firewall)\n\t- Podman\n\t\t- You need to open the firewall ports before your apps are accessible outside the host\n\t\t- You can follow this post to only open ports in your local network [Discourse: Open firewall ports towards local network](https://discourse.nixos.org/t/open-firewall-ports-only-towards-local-network/13037)\n\t- NixOS OCI containers\n\t\t- Cannot run in rootless mode at the system level\n\t\t\t- Nixpkgs issues\n\t\t\t\t- [nixos/virtualisation.oci-containers: --cidfile flag breaks podman containers running in rootless mode](https://github.com/NixOS/nixpkgs/issues/207050)\n\t\t\t- Podman discussions\n\t\t\t\t- [support User= in systemd for running rootless services](https://github.com/containers/podman/discussions/20573)\n\t\t- Could run in rootless mode if home-manager implements them at the user level\n\t\t\t- Home-manager issues\n\t\t\t\t- [Add support for rootless Podman](https://github.com/nix-community/home-manager/issues/4336)\n\t\t\t\t- [container: init service for linux and mac](https://github.com/nix-community/home-manager/pull/4331)\n- secret management\n\t- [Provide options for storing secrets outside the Nix store](https://github.com/NixOS/nixpkgs/issues/24288)\n\t- [Can Systemd 247 \"credentials\" logic solve secret management for us?](https://github.com/NixOS/nixpkgs/issues/102397)\n\t- [Handling Secrets in NixOS: An Overview](https://lgug2z.com/articles/handling-secrets-in-nixos-an-overview/)\n\t\t- [NixOS Discourse post](https://discourse.nixos.org/t/handling-secrets-in-nixos-an-overview-git-crypt-agenix-sops-nix-and-when-to-use-them/35462)\n\t- Newest attempt\n\t\t- [lib.types, formats: Introduce a new secret type and use it for generalized secret replacements in pkgs.formats](https://github.com/NixOS/nixpkgs/pull/179471)\n\t\t-",536881476]],["^15",[104,"^19",1712993843476,536870919]],["^15",[104,"^1:","~m1722609768615",536881477]],["^15",[104,"^Z","pages/NixOS.md",536870919]],["^15",[105,"^K",1712993843476,536870919]],["^15",[105,"^[",352,536872286]],["^15",[105,"^O","^16",536872281]],["^15",[105,"^@",false,536870919]],["^15",[105,"^Y","nix",536870919]],["^15",[105,"^11","Nix",536870919]],["^15",[105,"^?",["^ ","^17",["^18",["sysadmin"]]],536872284]],["^15",[105,"^4",["^ ","^17","sysadmin"],536872284]],["^15",[105,"^P",221,536872284]],["^15",[105,"^B",1717528914351,536873031]],["^15",[105,"^;","~u66ae334d-a88c-44f6-8cfe-682cfef8b78d",536881476]],["^15",[107,"^Q","[NixOS & Flakes Book](https://nixos-and-flakes.thiscute.world/)",536870919]],["^15",[107,"^O","^16",536870919]],["^15",[107,"^F",122,536870919]],["^15",[107,"^X",29,536870919]],["^15",[107,"^V",115,536870919]],["^15",[107,"^U",29,536872273]],["^15",[107,"^;","~u661a3633-09a6-4d8a-acd9-844e7ab96f31",536870919]],["^15",[108,"^Q","You can create a desktop entry using `pkgs.makeDesktopItem`",536870919]],["^15",[108,"^O","^16",536870919]],["^15",[108,"^F",111,536870919]],["^15",[108,"^X",29,536870919]],["^15",[108,"^V",114,536870919]],["^15",[108,"^U",29,536873273]],["^15",[108,"^;","~u661a3633-4a69-44f0-9a75-55e0295e6847",536870919]],["^15",[109,"^Q","[How to write conditional config](https://discourse.nixos.org/t/using-mkif-with-nested-if/5221/4)",536873207]],["^15",[109,"^O","^16",536870919]],["^15",[109,"^F",114,536870919]],["^15",[109,"^X",29,536870919]],["^15",[109,"^V",29,536870919]],["^15",[109,"^U",29,536870919]],["^15",[109,"^;","~u661a3633-def9-4e96-8b20-6ad4c6d17054",536870919]],["^15",[110,"^Q","[Nix manual](https://nixos.org/manual/nix/stable/)",536870919]],["^15",[110,"^O"