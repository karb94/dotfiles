,"NOW",536870914]],["^15",[5,"^;","~u664d2350-e700-49ae-bf95-fd803153b388",536870914]],["^15",[6,"^@",false,536870914]],["^15",[6,"^Y","later",536870914]],["^15",[6,"^11","LATER",536870914]],["^15",[6,"^;","~u661a3633-7fa4-4ceb-af79-28adc1af1074",536870919]],["^15",[7,"^@",false,536870914]],["^15",[7,"^Y","done",536870914]],["^15",[7,"^11","DONE",536870914]],["^15",[7,"^;","~u661a3633-7b65-41de-9683-0a795e4ecbd2",536870919]],["^15",[8,"^@",false,536870914]],["^15",[8,"^Y","doing",536870914]],["^15",[8,"^11","DOING",536870914]],["^15",[8,"^;","~u004e1941-2445-4d63-88fb-05dd18bdc69f",536870914]],["^15",[9,"^@",false,536870914]],["^15",[9,"^Y","in-progress",536870914]],["^15",[9,"^11","IN-PROGRESS",536870914]],["^15",[9,"^;","~u449c438b-6567-4fdf-b753-5d18e43e8540",536870914]],["^15",[10,"^@",false,536870914]],["^15",[10,"^Y","c",536870914]],["^15",[10,"^11","C",536870914]],["^15",[10,"^;","~u4073abc1-554d-4b6f-ba42-5c9b9dcb2fba",536870914]],["^15",[11,"^@",false,536870914]],["^15",[11,"^Y","b",536870914]],["^15",[11,"^11","B",536870914]],["^15",[11,"^;","~ue11f8a3c-2b5e-49db-b9b6-f262ff541c86",536870914]],["^15",[13,"^@",false,536870914]],["^15",[13,"^Y","waiting",536870914]],["^15",[13,"^11","WAITING",536870914]],["^15",[13,"^;","~u78e94945-8d3f-4121-9678-e0178f82991c",536870914]],["^15",[14,"^@",false,536870914]],["^15",[14,"^Y","favorites",536870914]],["^15",[14,"^11","Favorites",536870914]],["^15",[14,"^;","~u9fa8e9a3-aba8-49e2-95c7-1244bcc0abbb",536870914]],["^15",[15,"^@",false,536870914]],["^15",[15,"^Y","a",536870914]],["^15",[15,"^11","A",536870914]],["^15",[15,"^;","~ucc17e7b1-d648-4c89-ab29-8ff4b7745ab3",536870914]],["^15",[16,"^@",false,536870914]],["^15",[16,"^Y","cancelled",536870914]],["^15",[16,"^11","CANCELLED",536870914]],["^15",[16,"^;","~uac3313c3-fa8a-4b29-b81c-280cce8b0834",536870914]],["^15",[17,"^@",false,536870914]],["^15",[17,"^Y","wait",536870914]],["^15",[17,"^11","WAIT",536870914]],["^15",[17,"^;","~ue0eff527-cef7-4e88-92d4-d7c1ecb735ab",536870914]],["^15",[18,"^K",1712993843330,536870915]],["^15",[18,"^O","~:markdown",536870915]],["^15",[18,"^N",20240413,536870915]],["^15",[18,"^@",true,536870915]],["^15",[18,"^Y","apr 13th, 2024",536870915]],["^15",[18,"^11","Apr 13th, 2024",536870915]],["^15",[18,"^B",1712993843330,536870915]],["^15",[18,"^;","~u661a3633-2715-44e6-901f-34a0ed7d6c8b",536870915]],["^15",[19,"^Q","",536870916]],["^15",[19,"^O","^16",536870916]],["^15",[19,"^N",20240413,536870916]],["^15",[19,"^@",true,536870916]],["^15",[19,"^F",18,536870916]],["^15",[19,"^X",18,536870916]],["^15",[19,"^V",18,536870916]],["^15",[19,"^U",18,536870917]],["^15",[19,"^?",["^ "],536870916]],["^15",[19,"^;","~u661a3633-d36e-4e00-9e44-881a0bb9d53a",536870916]],["^15",[20,"^3","",536870918]],["^15",[20,"~:file/created-at",1712993843408,536870919]],["^15",[20,"^Z","logseq/custom.css",536870918]],["^15",[21,"^3","- Can't make [[Paperless]] work with podman\n\t- [Related issue](https://github.com/paperless-ngx/paperless-ngx/pull/1212)\n-",536870919]],["^15",[21,"^17",1712993843370,536870919]],["^15",[21,"^Z","journals/2023_06_25.md",536870919]],["^15",[22,"^K",1712993843369,536870919]],["^15",[22,"^[",21,536870919]],["^15",[22,"^N",20230625,536870919]],["^15",[22,"^@",true,536870919]],["^15",[22,"^Y","jun 25th, 2023",536870919]],["^15",[22,"^11","Jun 25th, 2023",536870919]],["^15",[22,"^B",1712993843369,536870919]],["^15",[22,"^;","~u661a3633-4145-41f7-b7dc-20437bfd28db",536870919]],["^15",[23,"^K",1712993843460,536870919]],["^15",[23,"^@",false,536870919]],["^15",[23,"^Y","paperless",536870919]],["^15",[23,"^11","Paperless",536870919]],["^15",[23,"^B",1712993843460,536870919]],["^15",[23,"^;","~u661a3633-8c9e-4034-90c0-6818bee41db4",536870919]],["^15",[24,"^Q","Can't make [[Paperless]] work with podman",536870919]],["^15",[24,"^O","^16",536870919]],["^15",[24,"^F",22,536870919]],["^15",[24,"^X",22,536870919]],["^15",[24,"^V",22,536870919]],["^15",[24,"^U",22,536870919]],["^15",[24,"^U",23,536870919]],["^15",[2