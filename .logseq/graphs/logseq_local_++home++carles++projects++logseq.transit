X",551,536873568]],["^15",[612,"^V",613,536873568]],["^15",[612,"^U",551,536873568]],["^15",[612,"^;","~u66708968-3554-4451-a86e-f8b27f317834",536873568]],["^15",[613,"^Q","Nomenclature",536873568]],["^15",[613,"^O","^16",536873568]],["^15",[613,"^F",605,536873568]],["^15",[613,"^X",551,536873568]],["^15",[613,"^V",551,536873568]],["^15",[613,"^U",551,536873568]],["^15",[613,"^;","~u66708968-5fd1-43e8-9dce-0ecb7b628153",536873568]],["^15",[614,"^Q","Counter-argument: higher commissions and transaction costs",536873568]],["^15",[614,"^O","^16",536873568]],["^15",[614,"^F",617,536873568]],["^15",[614,"^X",551,536873568]],["^15",[614,"^V",617,536873568]],["^15",[614,"^U",551,536873568]],["^15",[614,"^;","~u66708968-226a-49b2-a716-6f7b78117b74",536873568]],["^15",[615,"^Q","Standardised forward-like contract traded on ((6662db30-d722-494a-a5b7-89c5f5f12347))",536873568]],["^15",[615,"^O","^16",536873568]],["^15",[615,"^F",604,536873568]],["^15",[615,"^X",551,536873568]],["^15",[615,"^V",604,536873568]],["^15",[615,"^U",551,536873568]],["^15",[615,"^H",567,536873604]],["^15",[615,"^;","~u66708968-7646-463d-9188-9b867373c172",536873568]],["^15",[616,"^Q","short",536873568]],["^15",[616,"^O","^16",536873568]],["^15",[616,"^F",606,536873568]],["^15",[616,"^X",551,536873568]],["^15",[616,"^V",618,536873568]],["^15",[616,"^U",551,536873568]],["^15",[616,"^;","~u66708968-eab7-4527-970c-0cfbd0e8d8f8",536873568]],["^15",[617,"^Q","The company doesn't need to hedge because shareholders can hedge the company's risk themselves",536873568]],["^15",[617,"^O","^16",536873568]],["^15",[617,"^F",599,536873568]],["^15",[617,"^X",551,536873568]],["^15",[617,"^V",599,536873568]],["^15",[617,"^U",551,536873568]],["^15",[617,"^;","~u66708968-27d2-4b97-a2db-676cf91020c1",536873568]],["^15",[618,"^Q","Positions",536873568]],["^15",[618,"^O","^16",536873568]],["^15",[618,"^F",551,536873568]],["^15",[618,"^X",551,536873568]],["^15",[618,"^V",551,536873568]],["^15",[618,"^U",551,536873568]],["^15",[618,"^;","~u66708968-ad6d-4853-803f-5a2c07e5caaa",536873568]],["^15",[619,"^3","tags:: finance\n\n- bank reserves\n  id:: 6665782c-8bea-467c-8657-7183e047c130\n\t- Cash minimums that financial institutions must have on hand in order to meet central bank requirements\n\t- This is real paper money that must be kept by the bank in a vault on-site or held in its account at the central bank\n\t- Cash reserves requirements are intended to ensure that every bank can meet any large and unexpected demand for withdrawals\n- central counterparty (CPP)\n  id:: 6662df9e-cfb2-401a-96d8-f5d49aaed5b5\n\t- Just like an exchange, it stands between both parties of a transaction and assumes the risk of default of both parties\n- commercial bank\n  id:: 66670527-36b8-48cb-a890-6c1eb573c785\n\t- Financial institution that provide services to the general public (individuals or businesses)\n\t- They make money by accepting deposits and lending money\n- credit risk\n  id:: 66646454-fb25-4e4f-a97a-58c8e4490311\n\t- Borrower's risk of defaulting\n- credit spread\n  id:: 66646420-8442-4f99-bf07-8a0a4b5babec\n\t- extra amount added to a risk-free interest rate to allow for credit risk\n- depository institutions\n  id:: 66749db0-fe3a-40d0-9d39-fbed0fd07ff6\n\t- Financial institution that is allowed to accept monetary deposits from consumers\n- gilt\n  id:: 6674aff9-00e5-47ae-990b-2da1d55c1de3\n\t- UK Government bond\n- margin\n  id:: 6662de08-5b76-4d46-aa44-030d2182ef1e\n\t- Collateral that an investor has to deposit with their broker or exchange to cover the credit risk the holder poses for the broker or the exchange\n- market maker (liquidity provider)\n  id:: 6662e1f9-f6c9-4100-87bb-c7085423e2bc\n\t- A company or an individual that quotes both a buy and a sell price in a tradable asset held in inventory, hoping to make a profit on the bid–ask spread\n- monetary policy\n  id:: 667483a2-4985-4618-a070-1de207083ed8\n\t- Set of tools used by a nation's [[central bank]] to control the overall money supply and promote economic growth and employ strategies such as revising interest rates and changing bank reserve requirements\n\t- In the US, the Federal Reserve Act mandates that the Federal Reserve conduct monetary policy \"so as to promote effectively the goals of maximum employment, stable prices, and moderate long-term interest rates\n- security\n\t- a tradable financial asset\n- systemic risk\n  id:: 6662e5ae-3bda-4249-beab-be1e948ab483\n\t- Risk of an event at the company level triggering severe instability or collapse an entire industry or economy",536878938]],["^15",[619,"^19",1718651240287,536873570]],["^15",[619,"^1:","~m1718923353352",536878937]],["^15",[619,"^Z","pages/glossary.md",536873570]],["^15",[620,"^Q","Collateral that an investor has to deposit with their broker or exchange to cover the credit risk the holder poses for the broker or the exchange",536873570]],["^15",[620,"^O","^16",536873570]],["^15",[620,"^F",573,536873570]],["^15",[620,"^X",538,536873570]],["^15",[620,"^V",573,536873570]],["^15",[620,"^U",538,536878877]],["^15",[620,"^;","~u66708968-2e18-45e4-94b7-72523c0f3a36",536873570]],["^15",[621,"^Q","Risk of an event at the company level triggering severe instability or collapse an entire industry or economy",536873570]],["^15",[621,"^O","^16",536873570]],["^15",[621,"^F",574,536873570]],["^15",[621,"^X",538,536873570]],["^15",[621,"^V",574,536873570]],["^15",[621,"^U",538,536873570]],["^15",[621,"^;","~u66708968-b175-4d73-9d61-7ca530fd2bd1",536873570]],["^15",[622,"^Q","A company or an individual that quotes both a buy and a sell price in a tradable asset held in inventory, hoping to make a profit on the bid–ask spread",536873570]],["^15",[622,"^O","^16",536873570]],["^15",[622,"^F",558,536873570]],["^15",[622,"^X",538,536873570]],["^15",[622,"^V",558,536873570]],["^15",[622,"^U",538,536873570]],["^15",[622,"^;","~u66708968-c134-4234-a171-83da3b38cfa1",536873570]],["^15",[623,"^Q","security",536873570]],["^15",[623,"^O","^16",53