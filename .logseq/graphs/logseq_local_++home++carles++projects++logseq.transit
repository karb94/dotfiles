,[2456,"^U",1101,536897861]],["^15",[2456,"^;","~u6779bc9e-32e4-4728-a4e1-e8b28a0f3f68",536897861]],["^15",[2457,"^Q","Models are developed to ensure equivalent portfolios have equal payouts under all circumstances",536897861]],["^15",[2457,"^O","^16",536897861]],["^15",[2457,"^F",2456,536897861]],["^15",[2457,"^X",1101,536897861]],["^15",[2457,"^V",2456,536897861]],["^15",[2457,"^U",1101,536897861]],["^15",[2457,"^;","~u6779bc9e-1aff-4291-8cff-78023f490edf",536897861]],["^15",[2458,"^Q","TODO define an equivalent portfolio in glossary",536897861]],["^15",[2458,"^O","^16",536897861]],["^15",[2458,"^F",2463,536897861]],["^15",[2458,"^10","TODO",536897861]],["^15",[2458,"^X",1101,536897861]],["^15",[2458,"^V",2455,536897861]],["^15",[2458,"^U",4,536897861]],["^15",[2458,"^U",1101,536897861]],["^15",[2458,"^H",4,536897861]],["^15",[2458,"^;","~u6779bc9e-0e7e-43bf-a9e5-cb5aaeb86bbc",536897861]],["^15",[2459,"^Q","[Metaphors, Models & Theories](https://papers.ssrn.com/sol3/papers.cfm?abstract_id=1713405)",536897861]],["^15",[2459,"^O","^16",536897861]],["^15",[2459,"^F",2462,536897861]],["^15",[2459,"^X",1101,536897861]],["^15",[2459,"^V",1101,536897861]],["^15",[2459,"^U",1101,536897861]],["^15",[2459,"^;","~u6779bc9e-604d-476b-a4a7-b7ca18a303cb",536897861]],["^15",[2460,"^Q","law of one price",536897861]],["^15",[2460,"^O","^16",536897861]],["^15",[2460,"^F",2462,536897861]],["^15",[2460,"^X",1101,536897861]],["^15",[2460,"^V",2462,536897861]],["^15",[2460,"^U",1101,536897861]],["^15",[2460,"^;","~u6779bc9e-7633-4186-95ab-b3e50257c578",536897861]],["^15",[2462,"^Q","[The Boy's Guide to Pricing & Hedging](https://papers.ssrn.com/sol3/papers.cfm?abstract_id=364760)",536897861]],["^15",[2462,"^O","^16",536897861]],["^15",[2462,"^F",1125,536897861]],["^15",[2462,"^X",1101,536897861]],["^15",[2462,"^V",1101,536897861]],["^15",[2462,"^U",1101,536897861]],["^15",[2462,"^;","~u6779bc9e-fc00-4e5e-9431-cabc74136cc2",536897861]],["^15",[2463,"^Q","To value a security, build an equivalent (equal payouts) portfolio from other securities with known value",536897861]],["^15",[2463,"^O","^16",536897861]],["^15",[2463,"^F",2455,536897861]],["^15",[2463,"^X",1101,536897861]],["^15",[2463,"^V",2455,536897861]],["^15",[2463,"^U",1101,536897861]],["^15",[2463,"^;","~u6779bc9e-ecc6-46fe-8ff2-133e7beca5f8",536897861]],["^15",[2464,"^Q","Any two securities with identical future payouts, no matter how the future turns out, should have identical current prices.",536897861]],["^15",[2464,"^O","^16",536897861]],["^15",[2464,"^F",2460,536897861]],["^15",[2464,"^X",1101,536897861]],["^15",[2464,"^V",2460,536897861]],["^15",[2464,"^U",1101,536897861]],["^15",[2464,"^;","~u6779bc9e-eca7-42ce-8928-d0ff7bc4f334",536897861]],["^15",[2465,"^K",1736031636882,536897864]],["^15",[2465,"^[",2467,536897873]],["^15",[2465,"^O","^16",536897868]],["^15",[2465,"^@",false,536897864]],["^15",[2465,"^Y","stock pricing",536897917]],["^15",[2465,"^11","Stock pricing",536897917]],["^15",[2465,"^?",["^ ","^17",["^18",["finance"]]],536900431]],["^15",[2465,"^4",["^ ","^17","finance"],536900431]],["^15",[2465,"^P",1101,536900431]],["^15",[2465,"^B",1737411543527,536906332]],["^15",[2465,"^;","~u6779bd94-1dc1-43b4-ae4e-e897e4d1dbeb",536897864]],["^15",[2466,"^Q","Type of ((6779c61a-b203-4049-9b5e-1b70d517c5de)) where only the current value of a variable is relevant for predicting the future",536904069]],["^15",[2466,"^H",2658,536904069]],["^15",[2467,"^3","tags:: finance\n\n- Assumed to follow a ((6779beb2-03a4-4200-84cd-96002dd58cfa))\n\t- Consistent with\n\t\t- weak form of market efficiency\n\t\t\t- The present price of a stock accounts for all the information contained in past prices\n\t\t\t- If untrue, technical analysts could make above-average returns by interpreting charts of the past history of stock prices\n\t\t\t\t- if a pattern of past stock prices gave above-average returns market participants exploiting the pattern would immediately drive the price of the stock up until the returns of the stock are no longer above-average\n- Assumed to follow an ((d133a8fb-2f1f-464a-8b9d-4712bf3acb7d)) known as _geometric Brownian motion_\n\t- drift rate\n\t\t- $\\mu S$\n\t\t- where\n\t\t\t- $\\mu$ is the expected rate of return of a stock\n\t\t\t- $S$ is the price of the stock\n\t\t- rationale\n\t\t\t- Investors expect a return on the stock defined as a percentage of the current price, i.e. the expected return of a stock is not constant and grows at a continuously compounded rate\n\t- variance rate\n\t\t- $\\sigma^2 S^2$\n\t\t- where\n\t\t\t- $\\sigma$ is the volatility of the stock price\n\t\t\t- $S$ is the price of the stock\n\t\t- rationale\n\t\t\t- Investors expect the variability of the return to be independent of the price of the stock\n\t- Thus, after a small period of time $dt$ the change in the price of a stock $dS$ is defined as\n\t\t- $dS = \\mu S \\, dt + \\sigma S \\, dz$\n\t\t- or equivalently  $\\frac{dS}{S} = \\mu \\, dt + \\sigma \\, dz$\n\t\t- Therefore, the percentage change in the stock price is normally distributed\n- Follows a log-normal distribution\n\t- Proof using ((678d3bcc-03b2-4fbd-a783-857ab95d7f01))\n\t\t- Given the stock price, $S, is assumed to follow an ((d133a8fb-2f1f-464a-8b9d-4712bf3acb7d))\n\t\t  logseq.order-list-type:: number\n\t\t- If $G(x, t) = ln \\, S$\n\t\t  logseq.order-list-type:: number\n\t\t\t- $\\frac{\\partial G}{\\partial S} = \\frac{1}{S}$\n\t\t\t- $\\frac{\\partial^2 G}{\\partial S^2} = - \\frac{1}{S^2}$\n\t\t\t- $\\frac{\\partial G}{\\partial t} = 0$\n\t\t- It follows from the ((678d3bcc-03b2-4fbd-a783-857ab95d7f01))\n\t\t  logseq.order-list-type:: number\n\t\t\t- $dG = (\\mu - \\frac{\\sigma^2}{2}) \\, dt + \\sigma \\, dz$\n\t\t- Given \\mu and \\sigma are constant\n\t\t  logseq.order-list-type:: number\n\t\t\t- $G(x, t) = \\ln S$ follows a ((76f9cd9b-8fe6-4550-8152-3177dfaef1ed))\n\t\t\t\t- where\n\t\t\t\t\t- $\\mu - \\frac{\\sigma^2}{2}$ is the constant drift rate\n\t\t\t\t\t- $\\sigma^2$ is the constant variance\n\t\t\t\t- Thus, $dG$ is normally distributed\n\t\t- A random variable has a log-normal distribution if the natural logarithm of the variable is normally distributed\n\t\t  logseq.order-list-type:: number\n\t\t\t- Thus, $dS$ must be log-normally distributed\n\t\t- Additionally, when integrating by time from $t=0$ to $t=T$\n\t\t  logseq.order-list-type:: number\n\t\t\t- $\\ln S_T - \\ln S_o \\sim \\mathcal{N}[(\\mu - \\frac{\\sigma^2}{2})T, \\sigma^2T]$\n\t\t\t  logseq.order-list-type:: number\n\t\t\t- Or, $\\ln S_T \\sim \\mathcal{N}[\\ln  S_0 + (\\mu - \\frac{\\sigma^2}{2})T, \\sigma^2T]$\n\t\t\t  logseq.order-list-type:: number\n\t\t\t- $ln \\, S_T$ is normally distributed, thus, $S_T$ must be log-normally distributed\n\t\t\t  logseq.order-list-type:: number\n\t\t- From the properties of the log-normal distribution, it can be shown that\n\t\t  logseq.order-list-type:: number\n\t\t\t- $E(S_T) = S_0 e^{\\mu T}$\n\t\t\t- $\\mathrm{var}(S_T) = S_0^2 e^{2\\mu T} (e^{\\sigma^2T} - 1)$\n\t\t\t- TODO The distribution of the rate of return\n- probability distribution of the continuously compounded rate of return between $t=0$ and $t=T$\n\t- $S_T = S_0 e^{x T}$\n\t\t- where $x = \\frac{1}{T} \\ln \\frac{S_T}{S_0}$\n\t- Thus, $x \\sim \\mathcal{N}(\\mu - \\frac{\\sigma^2}{2}, \\frac{\\sigma^2}{T})$\n\t- As $T$ increases, the standard deviation of $x$ declines\n\t\t- We are more certain about the average return of long periods of time\n- mean return, $\\mu$, vs continuously compounded rate of return, $x$\n\t- The mean (or expected return) is the arithmetic mean return over a period of time\n\t- The continuously compounded rate of return is the geometric mean of the\n\t- not the same as the continuously compounded rate of return which has an expected value of $\\mu - \\frac{\\sigma^2}{2}$",536906334]],["^15",[2467,"^1:","~m1737411543743",536906333]],["^15",[2467,"^Z","pages/Stock pricing.md",536897918]],["^15",[2467,"^1;",3088,536904132]],["^15",[2472,"^Q","Assumed to follow a ((6779beb2-03a4-4200-84cd-96002dd58cfa))",536904359]],["^15",[2472,"^O","^16",536897949]],["^15",[2472,"^@",false,536897949]],["^15",[2472,"^F",2542,536904066]],["^15",[2472,"^X",2465,536897949]],["^15",[2472,"^V",2465,536897957]],["^15",[2472,"^U",2465,536904356]],["^15",[2472,"^U",2660,536904356]],["^15",[2472,"^?",["^ "],536904359]],["^15",[2472,"^H",2660,536904359]],["^15",[2472,"^;","~u6779bf23-26c8-4af4-9e7b-aa5623506e3c",536897949]],["^15",[2474,"^Q","Consistent with",536904262]],["^15",[2474,"^O","^16",536898041]],["^15",[2474,"^@",false,536898041]],["^15",[2474,"^F",2472,536898041]],["^15",[2474,"^X",2465,536898041]],["^15",[2474,"^V",2472,536898041]],["^15",[2474,"^U",2465,536904360]],["^15",[2474,"^U",2660,536904360]],["^15",[2474,"^?",["^ "],536904262]],["^15",[2474,"^;","~u6779bfba-936b-4a7c-87b9-f32a753a466d",536898041]],["^15",[2475,"^Q","The present price of a stock accounts for all the information contained in past prices",536898103]],["^15",[2475,"^O","^16",536898069]],["^15",[2475,"^@",false,536898069]],["^15",[2475,"^F",2726,536904262]],["^15",[2475,"^X",2465,536898069]],["^15",[2475,"^V",2726,536904268]],["^15",[2475,"^U",2465,536904360]],["^15",[2475,"^U",2660,536904360]],["^15",[2475,"^?",["^ "],536898103]],["^15",[2475,"^;","~u6779bfd6-bfce-42ca-a493-2096338c5949",536898069]],["^15",[2476,"^Q","If untrue, technical analysts could make above-average returns by interpreting charts of the past history of stock prices",536898140]],["^15",[2476,"^O","^16",536898106]],["^15",[2476,"^@",false,536898106]],["^15",[2476,"^F",2475,536898106]],["^15",[2476,"^X",2465,536898106]],["^15",[2476,"^V",2726,536904268]],["^15",[2476,"^U",2465,536904360]],["^15",[2476,"^U",2660,536904360]],["^15",[2476,"^?",["^ "],536898140]],["^15",[2476,"^;","~u6779c0cc-6aaa-4780-b605-0f5aeea47e67",536898106]],["^15",[2477,"^Q","if a pattern of past stock prices gave above-average returns market participants exploiting the pattern would immediately driv