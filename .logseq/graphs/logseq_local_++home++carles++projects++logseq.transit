,["^14",["^1G"]],536878930]],["^15",[587,"^4",["^ ","^1G","6662df9e-cfb2-401a-96d8-f5d49aaed5b5"],536878930]],["^15",[587,"^;","~u6662df9e-cfb2-401a-96d8-f5d49aaed5b5",536873565]],["^15",[588,"^Q","Traders do not need to be concerned about the creditworthiness of the counter-party",536873565]],["^15",[588,"^O","^16",536873565]],["^15",[588,"^F",583,536873565]],["^15",[588,"^X",537,536873565]],["^15",[588,"^V",566,536873565]],["^15",[588,"^U",537,536900495]],["^15",[588,"^;","~u66708968-0623-4526-9697-0634aec25a62",536873565]],["^15",[589,"^Q","types",536900490]],["^15",[589,"^O","^16",536873565]],["^15",[589,"^F",571,536873565]],["^15",[589,"^X",537,536873565]],["^15",[589,"^V",537,536873565]],["^15",[589,"^U",537,536873565]],["^15",[589,"^?",["^ "],536900490]],["^15",[589,"^;","~u66708968-c7c6-4721-9854-71bae932b39b",536873565]],["^15",[590,"^Q","Less trades than in ((6662db30-d722-494a-a5b7-89c5f5f12347)) but much larger volume per trade and total volume",536873565]],["^15",[590,"^O","^16",536873565]],["^15",[590,"^F",575,536873565]],["^15",[590,"^X",537,536873565]],["^15",[590,"^V",556,536873565]],["^15",[590,"^U",537,536900495]],["^15",[590,"^U",567,536900495]],["^15",[590,"^H",567,536876396]],["^15",[590,"^;","~u66708968-52a7-4a33-984d-3d124953ce86",536873565]],["^15",[591,"^Q","Reduce the risk of potential future movements in a market variable",536873565]],["^15",[591,"^O","^16",536873565]],["^15",[591,"^F",581,536873565]],["^15",[591,"^X",537,536873565]],["^15",[591,"^V",581,536873565]],["^15",[591,"^U",537,536873565]],["^15",[591,"^;","~u66708968-4eff-4992-9a46-189243c8f170",536873565]],["^15",[592,"^3","- Positions\n\t- long\n\t\t- Agreement to **buy** an asset at a certain future time for a certain price\n\t- short\n\t\t- Agreement to **sell** an asset at a certain future time for a certain price\n- You can enter into a forward contract for free\n- Can be used to hedge foreign currency risk or future asset price changes\n- Nomenclature\n\t- $K$: delivery price\n\t- $S_T$: spot price\n- $\\mathrm{payoff}$ on one unit of asset\n\t- Total gain or loss from the contract\n\t- Long position: $\\mathrm{payoff} = S_T - K$\n\t- Short position: $\\mathrm{payoff} = K - S_T$\n\t- $\\mathrm{payoff}(S_T$)\n\t\t- Linear with a slope of 1\n\t\t- Crosses $\\mathrm{payoff}=0$ at $K$\n- Future\n\t- Standardised forward-like contract traded on ((6662db30-d722-494a-a5b7-89c5f5f12347))\n\t- Generally used to trade specific commodities and financial assets\n- Arguments against hedging with forwards\n\t- The company doesn't need to hedge because shareholders can hedge the company's risk themselves\n\t\t- Counter-argument: higher commissions and transaction costs\n\t- A well diversified shareholder should be indifferent to price movements\n\t- If hedging is not the norm in a certain industry it may not make sense for a single company to choose to be different from all the others. Companies within the same industry tend to have similar prices (competition) and they adjust the prices to get a constant profit margin. In this scenario, if a single company hedges, its profit margins will be affected by price movements of raw materials as it will be forced to match prices to either not loose market share or not loose profits.\n\t- Hedging can lock you out of higher profits when the underlying asset price gets cheaper so it is hard to justify in hindsight to the shareholders so treasurers might avoid it\n- The forward price converges to the spot price as the delivery date approaches",536873604]],["^15",[592,"^19",1718651240263,536873568]],["^15",[592,"^1:","~m1717853444852",536873605]],["^15",[592,"^Z","pages/forward (future).md",536873568]],["^15",[592,"^1;",1830,536904132]],["^15",[593,"^Q","Hedging can lock you out of higher profits when the underlying asset price gets cheaper so it is hard to justify in hindsight to the shareholders so treasurers might avoid it",536873568]],["^15",[593,"^O","^16",536873568]],["^15",[593,"^F",594,536873568]],["^15",[593,"^X",551,536873568]],["^15",[593,"^V",599,536873568]],["^15",[593,"^U",551,536873568]],["^15",[593,"^;","~u66708968-006b-4dab-8d0b-53958f8b74f5",536873568]],["^15",[594,"^Q","If hedging is not the norm in a certain industry it may not make sense for a single company to choose to be different from all the others. Companies within the same industry tend to have similar prices (competition) and they adjust the prices to get a constant profit margin. In this scenario, if a single company hedges, its profit margins will be affected by price movements of raw materials as it will be forced to match prices to either not loose market share or not loose profits.",536873568]],["^15",[594,"^O","^16",536873568]],["^15",[594,"^F",608,536873568]],["^15",[594,"^X",551,536873568]],["^15",[594,"^V",599,536873568]],["^15",[594,"^U",551,536873568]],["^15",[594,"^;","~u66708968-04d3-4c45-8772-bbc30e9dc007",536873568]],["^15",[595,"^Q","Short position: $\\mathrm{payoff} = K - S_T$",536873568]],["^15",[595,"^O","^16",536873568]],["^15",[595,"^F",600,536873568]],["^15",[595,"^X",551,536873568]],["^15",[595,"^V",607,536873568]],["^15",[595,"^U",551,536873568]],["^15",[595,"^;","~u66708968-5f33-416e-9349-962141b588f5",536873568]],["^15",[596,"^Q","$K$: delivery price",536873568]],["^15",[596,"^O","^16",536873568]],["^15",[596,"^F",613,536873568]],["^15",[596,"^X",551,536873568]],["^15",[596,"^V",613,536873568]],["^15",[596,"^U",551,536873568]],["^15",[596,"^;","~u66708968-5a88-4980-8af4-4b934484b485",536873568]],["^15",[597,"^Q","You can enter into a forward contract for free",536873568]],["^15",[597,"^O","^16",536873568]],["^15",[597,"^F",618,536873568]],["^15",[597,"^X",551,536873568]],["^15",[597,"^V",551,536873568]],["^15",[597,"^U",551,536873568]],["^15",[597,"^;","~u66708968-12ef-4904-8ecb-16517b87903d",536873568]],["^15",[598,"^Q","Total gain or loss from the contract",536873568]],["^15",[598,"^O","^16",536873568]],["^15",[598,"^F",607,536873568]],["^15",[598,"^X",551,5368735