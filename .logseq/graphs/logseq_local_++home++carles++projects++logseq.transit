,["^15",[487,"^O","^16",536873365]],["^15",[487,"^F",486,536873365]],["^15",[487,"^X",439,536873365]],["^15",[487,"^V",483,536873365]],["^15",[487,"^U",439,536873366]],["^15",[487,"^;","~uaa95f66f-edc3-4a45-bfdf-1e43b88cfb57",536873365]],["^15",[488,"^12",2,536873380]],["^15",[493,"^12",2,536873392]],["^15",[494,"^12",2,536873404]],["^15",[495,"^Q","Use [collections.abc](https://docs.python.org/3/library/collections.abc.html) whenever possible.",536873421]],["^15",[495,"^O","^16",536873421]],["^15",[495,"^F",148,536873421]],["^15",[495,"^X",144,536873421]],["^15",[495,"^V",145,536873429]],["^15",[495,"^U",144,536873436]],["^15",[495,"^?",["^ "],536873421]],["^15",[495,"^;","~u1fee22a3-118d-4d81-a442-633900d50038",536873421]],["^15",[496,"^Q","Method signature forwarding for subclasses [is not possible at the moment](https://github.com/python/typing/discussions/1079).",536873421]],["^15",[496,"^O","^16",536873421]],["^15",[496,"^F",495,536873421]],["^15",[496,"^X",144,536873421]],["^15",[496,"^V",145,536873429]],["^15",[496,"^U",144,536873436]],["^15",[496,"^?",["^ "],536873421]],["^15",[496,"^;","~uab0bae15-0b65-4c61-938f-8af6a84639d3",536873421]],["^15",[497,"^Q","This was discussed in the official python forum: [Proposal: Add bound to ParamSpec](https://discuss.python.org/t/proposal-add-bound-to-paramspec/39979/1)",536873421]],["^15",[497,"^O","^16",536873421]],["^15",[497,"^F",496,536873421]],["^15",[497,"^X",144,536873421]],["^15",[497,"^V",496,536873421]],["^15",[497,"^U",144,536873436]],["^15",[497,"^?",["^ "],536873421]],["^15",[497,"^;","~u4a42aabd-b1a7-4ee8-a9c1-c7277e5ee8ba",536873421]],["^15",[515,"^Q","tags:: sysadmin\n\n",536873590]],["^15",[515,"^O","^16",536873477]],["^15",[515,"^1A",["^18",[]],536873590]],["^15",[515,"^@",false,536873477]],["^15",[515,"^F",363,536873477]],["^15",[515,"^X",363,536873477]],["^15",[515,"^V",363,536873477]],["^15",[515,"^U",221,536873480]],["^15",[515,"^U",363,536873480]],["^15",[515,"^:",true,536873590]],["^15",[515,"^?",["^ ","^17",["^18",["sysadmin"]]],536873590]],["^15",[515,"^J",["^17"],536873590]],["^15",[515,"^4",["^ ","^17","sysadmin"],536873590]],["^15",[515,"^H",221,536873590]],["^15",[515,"^;","~u6660b840-2470-4986-9844-06d7ae137e34",536873477]],["^15",[516,"^3","tags:: sysadmin\n\n- Bash\n\t- List of Commands\n\t\t- A `list` is a sequence of one or more pipelines separated by one of the operators `;`, `&`, `&&`, or `||`, and optionally terminated by one of `;`, `&`, or a `newline`\n\t\t- Of these list operators, `&&` and `||` have equal precedence, followed by `;` and `&`, which have equal precedence\n\t\t- A sequence of one or more newlines may appear in a `list` to delimit commands, equivalent to a semicolon\n\t- Compound Commands\n\t\t- Compound commands are the shell programming language constructs\n\t\t- Each construct begins with a reserved word or control operator and is terminated by a corresponding reserved word or operator\n\t\t- Any redirections associated with a compound command apply to all commands within that compound command unless explicitly overridden\n\t\t- In most cases a list of commands in a compound command’s description may be separated from the rest of the command by one or more newlines, and may be followed by a newline in place of a semicolon\n\t\t- Looping Constructs\n\t\t\t- ```bash\n\t\t\t  until test-commands; do consequent-commands; done\n\t\t\t  while test-commands; do consequent-commands; done\n\t\t\t  for name in words; do commands; done\n\t\t\t  ```\n\t\t- Conditional Constructs\n\t\t\t- ```bash\n\t\t\t  if test-commands; then\n\t\t\t    consequent-commands;\n\t\t\t  [elif more-test-commands; then\n\t\t\t    more-consequents;]\n\t\t\t  [else alternate-consequents;]\n\t\t\t  fi\n\t\t\t  \n\t\t\t  case word in\n\t\t\t      [ [(] pattern [| pattern]…) command-list ;;]…\n\t\t\t  esac\n\t\t\t  ```\n\t\t- Grouping Commands\n\t\t\t- ```bash\n\t\t\t  ( list )\n\t\t\t  { list; }\n\t\t\t  ```\n\t- Conditional expressions\n\t- TODO try [ble.sh](https://github.com/akinomyoga/ble.sh)",536873590]],["^15",[516,"^1:","~m1717750605882",536873591]],["^15",[516,"^Z","pages/shell.md",536873481]],["^15",[517,"^Q","Bash",536873489]],["^15",[517,"^O","^16",536873485]],["^15",[517,"^@",false,536873485]],["^15",[517,"^F",515,536873485]],["^15",[517,"^X",363,536873485]],["^15",[517,"^V",363,536873485]],["^15",[517,"^U",363,536873486]],["^15",[517,"^;","~u6660b859-3819-4632-9120-ded9c4da486d",536873485]],["^15",[518,"^Q","List of Commands",536873497]],["^15",[518,"^O","^16",536873492]],["^15",[518,"^@",false,536873492]],["^15",[518,"^F",517,536873492]],["^15",[518,"^X",363,536873492]],["^15",[518,"^V",517,536873496]],["^15",[518,"^U",363,536873493]],["^15",[518,"^;","~u6660b85b-fa9a-473f-99bf-51a67817bb18",536873492]],["^15",[519,"^Q","A `list` is a sequence of one or more pipelines separated by one of the operators `;`, `&`, `&&`, or `||`, and optionally terminated by one of `;`, `&`, or a `newline`",536873497]],["^15",[519,"^O","^16",536873497]],["^15",[519,"^F",518,536873497]],["^15",[519,"^X",363,536873497]],["^15",[519,"^V",518,536873497]],["^15",[519,"^U",363,536873498]],["^15",[519,"^;","~u85f3ea1d-f90f-4c1f-b004-d522cb693d5b",536873497]],["^15",[520,"^Q","Of these list operators, `&&` and `||` have equal precedence, followed by `;` and `&`, which have equal precedence",536873497]],["^15",[520,"^O","^16",536873497]],["^15",[520,"^F",519,536873497]],["^15",[520,"^X",363,536873497]],["^15",[520,"^V",518,536873497]],["^15",[520,"^U",363,536873498]],["^15",[520,"^;","~u851d2346-2d35-4b02-9673-fbda6db5c046",536873497]],["^15",[521,"^Q","A sequence of one or more newlines may appear in a `list` to delimit commands, equivalent to a semicolon",536873497]],["^15",[521,"^O","^16",536873497]],["^15",[521,"^F",520,536873497]],["^15",[521,"^X",363,536873497]],["^15",[521,"^V",518,536873497]],["^15",[521,"^U",363,536873498]],["^15",[521,"^;","~u4e027579-661c-4c61-ac80-8c13658f1433",536873497]],["^15",[522,"^Q","Compound Commands",536873497]],["^15",[522,"^O","^16",536873497]],["^15",[522,"^F",518,536873497]],["^15",[522,"^X",363,536873497]],["^15",[522,"^V",517,536873497]],["^15",[522,"^U",363,536873498]],["^15",[522,"^;","~u4c195504-4992-4f66-a890-bcdb3ae9814c",536873497]],["^15",[523,"^Q","Compound commands are the shell programming language constructs",536873497]],["^15",[523,"^O","^16",536873497]],["^15",[523,"^F",522,536873497]],["^15",[523,"^X",363,536873497]],["^15",[523,"^V",522,536873497]],["^15",[523,"^U",363,536873498]],["^15",[523,"^;","~u8038ca29-7be9-472c-a9b8-1d2ecdf17720",536873497]],["^15",[524,"^Q","Each construct begins with a reserved word or control operator and is terminated by a corresponding reserved word or operator",536873497]],["^15",[524,"^O","^16",536873497]],["^15",[524,"^F",523,536873497]],["^15",[524,"^X",363,536873497]],["^15",[524,"^V",522,536873497]],["^15",[524,"^U",363,536873498]],["^15",[524,"^;","~u329a0c7a-c60c-4997-9729-af393525ff5e",536873497]],["^15",[525,"^Q","Any redirections associated with a compound command apply to all commands within that compound command unless explicitly overridden",536873497]],["^15",[525,"^O","^16",536873497]],["^15",[525,"^F",524,536873497]],["^15",[525,"^X",363,536873497]],["^15",[525,"^V",522,536873497]],["^15",[525,"^U",363,536873498]],["^15",[525,"^;","~u4ce95a96-0625-4540-9351-7009d3428d74",536873497]],["^15",[526,"^Q","In most cases a list of commands in a compound command’s description may be separated from the rest of the command by one or more newlines, and may be followed by a newline in place of a semicolon",536873497]],["^15",[526,"^O","^16",536873497]],["^15",[526,"^F",525,536873497]],["^15",[526,"^X",363,536873497]],["^15",[526,"^V",522,536873497]],["^15",[526,"^U",363,536873498]],["^15",[526,"^;","~uad7561a5-5b94-4aac-8198-7f6349390bc4",536873497]],["^15",[527,"^Q","Looping Constructs",536873497]],["^15",[527,"^O","^16",536873497]],["^15",[527,"^F",526,536873497]],["^15",[527,"^X",363,536873497]],["^15",